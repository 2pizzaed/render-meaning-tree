        </object>
        <object label="&lt;b&gt;Фрагмент: классификация найденного действия&lt;/b&gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;classifyAction(N — найденное действие)&lt;/font&gt;" tpgKind="Fragment" tpgProcedure="fragment classifyAction(N: ConcreteAction)" tpgSource="domain/findCorrect.tpg :: fragment classifyAction(N: ConcreteAction)" id="g_cls">
