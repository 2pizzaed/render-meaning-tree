        <object label="&lt;b&gt;Отношения между объектами&lt;/b&gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;относится к&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действию&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;выполнен по&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правилу перехода&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;&amp;gt;, &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;имеет&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;значение времени выполнения&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;1&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;непосредственно перед&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;2&amp;gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;(шкала: линейная; производные: &lt;/font&gt;&lt;font color=&quot;#0099A8&quot;&gt;перед&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;, &lt;/font&gt;&lt;font color=&quot;#0099A8&quot;&gt;между&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;, &lt;/font&gt;&lt;font color=&quot;#0099A8&quot;&gt;ближе к&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;)&lt;/font&gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;1&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;непосредственно перед&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;2&amp;gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;(шкала: линейная)&lt;/font&gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;принадлежит&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкту&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;порождено&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правилом действия&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;порождён&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правилом конструкта&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;1&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;вложен в&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;2&amp;gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;(частичная шкала; транзитивное: &lt;/font&gt;&lt;font color=&quot;#0099A8&quot;&gt;предок&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;)&lt;/font&gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило перехода&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;ведёт из&lt;/font&gt; / &lt;font color=&quot;#0099A8&quot;&gt;ведёт в&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило действия&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило перехода&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;при отсутствии цели ведёт в&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;цепочку правил действий&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило перехода&lt;/font&gt;&amp;gt;, &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило действия&lt;/font&gt;&amp;gt;, &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;имеет&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;эффект&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило перехода&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;имеет&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;ограничение&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило конструкта&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;содержит&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правила действий&lt;/font&gt;&amp;gt;, &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правила переходов&lt;/font&gt;&amp;gt;" tpgKind="Dictionary" tpgDict="Relationships between objects" tpgHint="TraceAct: hasAction(ConcreteAction) {*-&gt;1}, hasTransition(TransitionSpec) {*-&gt;1}, hasValue(SemanticValue), directlyBeforeOf(TraceAct): linear (+opposite directlyAfterOf, transitive beforeOf/afterOf, between isBetween, closer isCloserToThan, further isFurtherFromThan); ConcreteAction: belongsTo(ConcreteConstruct) {*-&gt;1}, derivedFrom(ActionSpec) {*-&gt;1}, hasEffects(Effect) {*-&gt;1}, directlyBeforeOf(ConcreteAction): linear; ConcreteConstruct: hasActions(ConcreteAction) {1-&gt;*}, derivedFrom(ConstructSpec) {*-&gt;1}, hasParent(ConcreteConstruct): partial, hasAncestor: transitive to hasParent; TransitionSpec: from_(ActionSpec), to_(ActionSpec) {*-&gt;1}, to_when_absent(ActionSpecChainPlaceholder) {*-&gt;1}, belongsTo(ConstructSpec) {*-&gt;1}, hasConstraints(Constraint) {*-&gt;1}, hasEffects(Effect) {*-&gt;1}; ActionSpec: belongsTo(ConstructSpec) {*-&gt;1}, hasEffects(Effect) {*-&gt;1}; ConstructSpec: hasActions {1-&gt;*}, hasTransitions {1-&gt;*}; ActionSpecChainPlaceholder: contains(ActionSpec) {*-&gt;1}, directlyBeforeOf: linear" id="n_rels">
