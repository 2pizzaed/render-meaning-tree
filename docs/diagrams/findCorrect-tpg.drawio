        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Привести&lt;/font&gt; точку отсчёта &lt;font color=&quot;#B38F00&quot;&gt;L&lt;/font&gt; к &lt;font color=&quot;#CC0066&quot;&gt;действию&lt;/font&gt;, от которого возможен &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;фрагмент «Нормализация точки отсчёта» — стр. 2&lt;/font&gt;" tpgKind="ProcedureCallNode" tpgProcedure="fragment findLastTracedAction(last: TraceAct)" tpgExpr="`fragment`:findLastTracedAction(L) out true, null;" tpgOutcomes="CORRECT → out, NULL → out (ERROR терминален внутри фрагмента)" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_call_flta">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1">
