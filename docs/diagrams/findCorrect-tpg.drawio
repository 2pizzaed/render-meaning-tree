        <object label="1. &lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;: совпадают и &lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt;, и &lt;font color=&quot;#009900&quot;&gt;значение условия&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="T: TransitionSpec" tpgExpr="find TransitionSpec t {&#xa;    $t-&gt;from_ == L-&gt;hasAction-&gt;derivedFrom and&#xa;    $t-&gt;belongsTo == L-&gt;hasAction-&gt;belongsTo-&gt;derivedFrom and&#xa;    $t=&gt;hasConstraints() and&#xa;    S.interruption_mode == $t-&gt;hasConstraints.interruption_mode and&#xa;    $t-&gt;hasConstraints.interruption_mode != InterruptionType:any and&#xa;    L=&gt;hasValue() and&#xa;    findUnusedValue(L-&gt;hasAction).bool_value == $t-&gt;hasConstraints.condition_value&#xa;}" tpgNote="фазы связаны merge: исход «найдено» любой фазы ведёт в общее продолжение" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_T1">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="340" x="530" y="2550" as="geometry" />
          </mxCell>
        </object>
        <object label="2. &lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt;: совпадает &lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt; (&lt;font color=&quot;#009900&quot;&gt;значение условия&lt;/font&gt; — если оно есть)&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="T: TransitionSpec" tpgExpr="find TransitionSpec t {&#xa;    $t-&gt;from_ == L-&gt;hasAction-&gt;derivedFrom and&#xa;    $t-&gt;belongsTo == L-&gt;hasAction-&gt;belongsTo-&gt;derivedFrom and&#xa;    $t=&gt;hasConstraints() and (&#xa;        S.interruption_mode == $t-&gt;hasConstraints.interruption_mode&#xa;        and $t-&gt;hasConstraints.interruption_mode != InterruptionType:any&#xa;    ) and (&#xa;        not L=&gt;hasValue() or&#xa;        findUnusedValue(L-&gt;hasAction).bool_value == $t-&gt;hasConstraints.condition_value&#xa;    )&#xa;}" tpgNote="фазы связаны merge: исход «найдено» любой фазы ведёт в общее продолжение" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_T2">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="340" x="990" y="2550" as="geometry" />
          </mxCell>
        </object>
        <object label="3. &lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt;: совпадает только &lt;font color=&quot;#009900&quot;&gt;значение условия&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="T: TransitionSpec" tpgExpr="find TransitionSpec t {&#xa;    $t-&gt;from_ == L-&gt;hasAction-&gt;derivedFrom and&#xa;    $t-&gt;belongsTo == L-&gt;hasAction-&gt;belongsTo-&gt;derivedFrom and&#xa;    $t=&gt;hasConstraints() and (&#xa;        S.interruption_mode == $t-&gt;hasConstraints.interruption_mode&#xa;        or $t-&gt;hasConstraints.interruption_mode == InterruptionType:any&#xa;    ) and (&#xa;        L=&gt;hasValue() and&#xa;        findUnusedValue(L-&gt;hasAction).bool_value == $t-&gt;hasConstraints.condition_value&#xa;    )&#xa;}" tpgNote="фазы связаны merge: исход «найдено» любой фазы ведёт в общее продолжение" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_T3">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="340" x="1450" y="2550" as="geometry" />
          </mxCell>
        </object>
        <object label="4. &lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; без &lt;font color=&quot;#CC0066&quot;&gt;ограничений&lt;/font&gt; или с &lt;font color=&quot;#009900&quot;&gt;режимом прерывания&lt;/font&gt; «&lt;font color=&quot;#009900&quot;&gt;любое&lt;/font&gt;»&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="T: TransitionSpec" tpgExpr="find TransitionSpec t {&#xa;    $t-&gt;from_ == L-&gt;hasAction-&gt;derivedFrom and&#xa;    $t-&gt;belongsTo == L-&gt;hasAction-&gt;belongsTo-&gt;derivedFrom and&#xa;    (not $t=&gt;hasConstraints() or (&#xa;        S.interruption_mode == $t-&gt;hasConstraints.interruption_mode&#xa;        or $t-&gt;hasConstraints.interruption_mode == InterruptionType:any&#xa;    )) and (not L=&gt;hasValue() or&#xa;        findUnusedValue(L-&gt;hasAction).bool_value == $t-&gt;hasConstraints.condition_value&#xa;    )&#xa;}" tpgNote="фазы связаны merge: исход «найдено» любой фазы ведёт в общее продолжение" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_T4">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="340" x="1910" y="2550" as="geometry" />
