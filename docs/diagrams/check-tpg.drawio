        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Ведут ли&lt;/font&gt; роли &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt; и &lt;font color=&quot;#B38F00&quot;&gt;D_a&lt;/font&gt; каждая своим &lt;font color=&quot;#CC0066&quot;&gt;переходом&lt;/font&gt; прямо в &lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt; — это альтернативные ветви одного ветвления?" tpgKind="QuestionNode" tpgExpr="branchAlternatives(Dp, Da, C)&#10;&#10;// lambda branchAlternatives(fromA, toA, C) = forAny TransitionSpec t1 {&#10;//     $t1-&gt;belongsTo == C-&gt;derivedFrom and $t1-&gt;from_ == fromA-&gt;derivedFrom and $t1-&gt;to_.role == &quot;END&quot; } and&#10;// forAny TransitionSpec t2 { $t2-&gt;belongsTo == C-&gt;derivedFrom and&#10;//     $t2-&gt;from_ == toA-&gt;derivedFrom and $t2-&gt;to_.role == &quot;END&quot; };" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct) :: agg and { transitionFromDp -&gt; { … } }" tpgNote="отличает «другую, уже исключённую ветвь того же ветвления» от настоящего пропуска действий" id="lv_q_branchalt">
          <mxCell parent="g_level" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="200" width="380" x="2390" y="1680" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Выполнение уже идёт по другой ветви&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;condition_value_not_considered&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="condition_value_not_considered" tpgRuExplanation="Нельзя выполнить это действие: оно в другой ветви, а выполнение уже идёт по ветви, выбранной значением условия." tpgEnExplanation="This action cannot be performed: it is in another branch, and execution already follows the branch chosen by the condition value." tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct) :: agg and { transitionFromDp -&gt; { … } }" id="lv_e_branchalt">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="150" width="260" x="2050" y="1705" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Стоит ли&lt;/font&gt; роль &lt;font color=&quot;#B38F00&quot;&gt;D_a&lt;/font&gt; &lt;font color=&quot;#0099A8&quot;&gt;раньше&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt; по порядку и (в текущем контексте не выполнялась, либо &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt; ещё &lt;font color=&quot;#009900&quot;&gt;ждёт&lt;/font&gt; завершения раскрытого из него вызова)?" tpgKind="QuestionNode" tpgExpr="Da=&gt;beforeOf(Dp) and (not actAlreadyCurrent(Da, Dp) or awaitsUnfoldedConstruct(Dp, C))&#10;&#10;// lambda awaitsUnfoldedConstruct(D, C) = forAny ConcreteConstruct cc {&#10;//     $cc != C and $cc.ast_id == D.ast_id and&#10;//     $cc-&gt;derivedFrom.preorder and isConstructOpen($cc) };" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct) :: agg and { transitionFromDp -&gt; { … } }" tpgNote="пока D_p ждёт завершения раскрытого из него preorder-конструкта, акта D_p в трассе ещё нет — actAlreadyCurrent этого не видит, поэтому нужен явный критерий awaitsUnfoldedConstruct" id="lv_q_passed">
          <mxCell parent="g_level" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="210" width="400" x="2380" y="1970" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие уже позади&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;action_already_passed&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="action_already_passed" tpgRuExplanation="Нельзя выполнить это действие: оно уже позади по ходу выполнения, вернуться к нему нельзя." tpgEnExplanation="This action cannot be performed: execution has already passed it, and it cannot be returned to." tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_e_passed">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="120" width="220" x="2090" y="2015" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Стоит ли&lt;/font&gt; роль &lt;font color=&quot;#B38F00&quot;&gt;D_a&lt;/font&gt; &lt;font color=&quot;#0099A8&quot;&gt;позже&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt; по порядку?" tpgKind="QuestionNode" tpgExpr="Da=&gt;afterOf(Dp)" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_q_after">
          <mxCell parent="g_level" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="140" width="280" x="2440" y="2280" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Впереди есть невыполненные действия&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;actions_skipped&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="actions_skipped" tpgRuExplanation="Нельзя выполнить это действие: перед ним есть невыполненные действия, которые нельзя пропустить." tpgEnExplanation="This action cannot be performed: there are earlier actions that have not been performed and cannot be skipped." tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_e_skippedacts">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="120" width="200" x="2110" y="2290" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Перехода к этому действию нет&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;no_transition&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="no_transition" tpgRuExplanation="Нельзя выполнить это действие: переход к нему из текущей точки выполнения не предусмотрен." tpgEnExplanation="This action cannot be performed: there is no transition to it from the current point of execution." tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_e_notrans">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="100" width="200" x="2480" y="2510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Соблюдён ли&lt;/font&gt; порядок в цепочке однотипных &lt;font color=&quot;#CC0066&quot;&gt;действий&lt;/font&gt;: &lt;font color=&quot;#B38F00&quot;&gt;D_a&lt;/font&gt; — ближайшая подходящая роль &lt;font color=&quot;#0099A8&quot;&gt;после&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt;?" tpgKind="QuestionNode" tpgExpr="not Dp=&gt;directlyBeforeOf() or&#10;actAlreadyCurrent(Da, Dp) or&#10;(&#10;    Da=&gt;afterOf(Dp) and&#10;    not forAny ConcreteAction mid {&#10;        $mid != Da and&#10;        $mid-&gt;derivedFrom == Da-&gt;derivedFrom and&#10;        $mid-&gt;belongsTo == C and&#10;        $mid=&gt;afterOf(Dp) and&#10;        Da=&gt;afterOf($mid)&#10;    }&#10;) or&#10;(&#10;    not forAny ConcreteAction fwd {&#10;        $fwd-&gt;derivedFrom == Da-&gt;derivedFrom and&#10;        $fwd-&gt;belongsTo == C and&#10;        $fwd=&gt;afterOf(Dp)&#10;    }&#10;)&#10;&#10;// lambda actAlreadyCurrent(Da, Dp) = forAny TraceAct t {&#10;//     $t-&gt;hasAction == Da and&#10;//     not forAny TraceAct u { $u-&gt;hasAction == Dp and $u=&gt;afterOf($t) } };" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" tpgNote="зеркало поиска ближайшего подходящего действия N в findCorrect" id="lv_q_order">
          <mxCell parent="g_level" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="210" width="380" x="3030" y="1680" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Нарушен порядок: нужно более близкое действие той же роли&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;actions_order_violated&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="actions_order_violated" tpgRuExplanation="Нельзя выполнить это действие: нарушен порядок — должно быть выполнено более близкое действие той же роли." tpgEnExplanation="This action cannot be performed: the order is violated — a closer action of the same role must be performed instead." tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_e_order">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="150" width="260" x="3490" y="1710" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Есть ли&lt;/font&gt; такой &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt;, у которого выполнено &lt;font color=&quot;#CC0066&quot;&gt;ограничение&lt;/font&gt; по &lt;font color=&quot;#009900&quot;&gt;режиму прерывания&lt;/font&gt;?" tpgKind="QuestionNode" tpgExpr="forAny TransitionSpec t { transitionLeads($t, Dp, Da, C) and interruptionOk($t, S) }" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_q_intr">
          <mxCell parent="g_level" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="180" width="360" x="3040" y="1970" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Не учтено активное прерывание&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;interruption_not_considered&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="interruption_not_considered" tpgRuExplanation="Нельзя выполнить это действие: не учтено текущее прерывание, меняющее обычный порядок выполнения." tpgEnExplanation="This action cannot be performed: the active interruption that changes the usual execution order is not taken into account." tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_e_intr">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="120" width="260" x="3490" y="2000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Есть ли&lt;/font&gt; такой &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt;, у которого выполнено ещё и &lt;font color=&quot;#CC0066&quot;&gt;ограничение&lt;/font&gt; по &lt;font color=&quot;#009900&quot;&gt;значению условия&lt;/font&gt;?" tpgKind="QuestionNode" tpgExpr="forAny TransitionSpec t { transitionLeads($t, Dp, Da, C) and interruptionOk($t, S) and conditionOk($t, Dp) }" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_q_cond">
          <mxCell parent="g_level" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="180" width="360" x="3040" y="2240" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Не учтено значение условия&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;condition_value_not_considered&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="condition_value_not_considered" tpgRuExplanation="Нельзя выполнить это действие: не учтено вычисленное значение условия." tpgEnExplanation="This action cannot be performed: the evaluated value of the condition is not taken into account." tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_e_cond">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="120" width="260" x="3490" y="2270" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;, который раскрывается ролью &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;D_cc&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="Dcc: ConcreteConstruct" tpgExpr="find ConcreteConstruct cc { $cc != C and $cc.ast_id == Dp.ast_id }" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_find_dcc">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="120" width="260" x="4780" y="1080" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Уровень пройден&lt;/b&gt;&lt;br&gt;предыдущая роль атомарна — завершать нечего" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgExpr="conclude: correct;" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_r_atomic">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="120" width="240" x="5190" y="1080" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; последний &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt; для роли &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;D_pAct&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="DpAct: TraceAct" tpgExpr="lastActOf(Dp)   // findExtreme latest [not $latest=&gt;beforeOf($t)] among TraceAct t { $t-&gt;hasAction == D }" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_find_dpact">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="120" width="220" x="4800" y="1290" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Нет акта трассы для роли&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;внутреннее исключение рассуждателя&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgException="true" tpgExceptionName="NoActForRoleAction" tpgExpr="conclude: error [ exception = true; exceptionName = &quot;NoActForRoleAction&quot;; ];" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_exc_noact">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;" vertex="1">
            <mxGeometry height="120" width="260" x="3900" y="1290" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Завершена ли&lt;/font&gt; эта &lt;font color=&quot;#CC0066&quot;&gt;конструкция&lt;/font&gt; в контексте того &lt;font color=&quot;#CC0066&quot;&gt;акта трассы&lt;/font&gt;?&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;у раскрываемой раньше своего действия END ищется до акта&lt;/font&gt;" tpgKind="QuestionNode" tpgExpr="unfoldedConstructFinished(Dcc, DpAct)&#10;&#10;// lambda unfoldedConstructFinished(C, E) = C-&gt;derivedFrom.preorder ? isClosedBefore(C, E) : isClosedAfter(C, E);&#10;// lambda isClosedAfter(C, E) = forAny TraceAct e { END акт C после E, без BEGIN C после него };&#10;// lambda isClosedBefore(C, E) = forAny TraceAct e { END акт C до E, без BEGIN C между ним и E };" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_q_closed">
          <mxCell parent="g_level" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="220" width="380" x="4720" y="1530" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Предыдущая конструкция ещё не завершена&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;construct_not_closed&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="construct_not_closed" tpgRuExplanation="Нельзя выполнить это действие: предыдущая конструкция ещё не завершена (или ещё не начата)." tpgEnExplanation="This action cannot be performed: the previous construct is not finished yet (or has not started)." tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_e_notclosed">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="150" width="220" x="5180" y="1565" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Уровень пройден&lt;/b&gt;&lt;br&gt;все критерии этого уровня выполнены" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgExpr="conclude: correct;" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_r_ok">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="110" width="300" x="2400" y="690" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Порядок внутри ветви &lt;/b&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;transitionFromDp&lt;/font&gt;&lt;b&gt; важен&lt;/b&gt;&lt;br&gt;Внутри этой ветви критерии по-прежнему идут от грубых к точным: сначала пропуск &lt;font color=&quot;#CC0066&quot;&gt;действий&lt;/font&gt;, затем само наличие &lt;font color=&quot;#CC0066&quot;&gt;перехода&lt;/font&gt;, и только потом его &lt;font color=&quot;#CC0066&quot;&gt;ограничения&lt;/font&gt;.&lt;br&gt;&lt;br&gt;А вот между &lt;b&gt;тремя ветвями&lt;/b&gt; агрегации AND (шестиугольник выше) порядка больше нет — они независимы, и при нарушении сразу нескольких студент получает &lt;b&gt;все&lt;/b&gt; объяснения, а не только первое по цепочке." tpgKind="Comment" id="lv_note_order">
          <mxCell parent="g_level" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=16;" vertex="1">
            <mxGeometry height="180" width="520" x="3450" y="2500" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size: 18px;&quot;&gt;Потенциально не уточненная причина&lt;/font&gt;" tpgKind="Comment" id="32H8Q0yy_RHuGj364iQW-1">
          <mxCell parent="g_level" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=16;" vertex="1">
            <mxGeometry height="84" width="204" x="2150" y="2518" as="geometry" />
