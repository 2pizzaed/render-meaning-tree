        <object label="&lt;b&gt;Найден ответ: &lt;/b&gt;&lt;font color=&quot;#B38F00&quot;&gt;N&lt;/font&gt;&lt;b&gt; — новое корректное действие&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;добавлено&lt;/font&gt; в трассу как &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt; будет добавлен на следующем шаге" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgEffect="P = +obj : TraceAct ({ hasAction(N); hasTransition(T);&#xa;    (N=&gt;hasValue()) ? hasValue(findUnusedValue(N)); });&#xa;unwindPrev +=&gt; directlyBeforeOf(P);&#xa;L = P;&#xa;unwindPrev = L;&#xa;if (N=&gt;hasValue()) P-&gt;hasValue.used = true;&#xa;if (N=&gt;hasEffects()) applyInterruptionMode(N-&gt;hasEffects, S);&#xa;if (T=&gt;hasEffects()) applyInterruptionMode(T-&gt;hasEffects, S);" tpgExpr="conclude : true with ({ … });" tpgSource="domain/findCorrect.tpg :: fragment unwindNewConstruct(C: ConcreteConstruct)" id="u_res_p">
