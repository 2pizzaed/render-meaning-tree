        <object label="&lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;&lt;b&gt; конструкта добавлен в трассу&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt; = &lt;font color=&quot;#B38F00&quot;&gt;L&lt;/font&gt; = новый &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt; действия" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgEffect="P = +obj : TraceAct ({ hasAction(A); });&#xa;Prev +=&gt; directlyBeforeOf(P);&#xa;L = P;&#xa;if (A-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(A-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S);&#xa;// Prev = findExtreme lastAct [not $lastAct=&gt;beforeOf($a)] among TraceAct a {true}" tpgExpr="conclude: true with ({ ... })" tpgAdaptation="служебный поиск предыдущего акта трассы (var Prev = findExtreme …) не показан отдельным узлом; его выражение — в tpgEffect" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_res_begin">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;dashed=1;dashPattern=6 4;" vertex="1">
