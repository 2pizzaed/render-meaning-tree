lambda applyInterruptionMode(T: TransitionSpec, S: TraceState) =
    if (T=>hasEffects()) {
        T->hasEffects.interruption_start != InterruptionType:none ? 
            T->hasEffects.interruption_start
        : (
            T->hasEffects.interruption_stop != InterruptionType:none and (
                T->hasEffects.interruption_stop == InterruptionType:any or
                S.interruption_mode == T->hasEffects.interruption_stop
            )
                ? InterruptionType:none
                : S.interruption_mode
        );
    };

lambda findUnusedValue(A: ConcreteAction) = findExtreme unused [
    $unused == A->hasValue or $unused=>isCloserToThan(A->hasValue, $v)
] among SemanticValue v {
    A=>hasValue() and ($v=>afterOf(A->hasValue) or $v == A->hasValue) and not $v.used
};

fragment findLastTracedAction(last: TraceAct) {
    // фрагмент поиска "реального" последнего действия, от которого будет происходить дальнейший поиск следующего корректного

    // последнее вычисленное действие является END в его конструкте
    ask (last->hasAction->derivedFrom.role == "END") out false else {
        // ищем еще незавершенное действие конструкта, который ближе к P (но не сам конструкт из P)
        var possibleLast: TraceAct = findExtreme lastAct [not $lastAct=>beforeOf($c)] among TraceAct c {
            $c->hasAction->derivedFrom.role != "END" and 
            not forAny TraceAct t2 {
                $t2->hasAction->belongsTo == $c->hasAction->belongsTo and 
                $t2->hasAction->derivedFrom.role == "END" and 
                $t2=>afterOf($c)
            }
        } out true else {conclude : error [exception = true;];};
        conclude: true with (last = possibleLast);
    };
    // Если последнее действие - это добавление в стек вызовов (прыжок в функцию)
    ask (last=>hasTransition() and last->hasTransition=>hasEffects() and 
        last->hasTransition->hasEffects.call_stack != CallStackAction:none
    ) out false else {
        // Ищем начало тела функции и создаем акт вызова функции
        var callAction: ConcreteAction = find ConcreteAction a {
            $a->derivedFrom.role == "BEGIN" and
            $a.ast_id == last->hasAction.ast_id
        } out true else {conclude : error [exception = true;];};
        var actionValue: SemanticValue = findUnusedValue(callAction) {
            true, false -> out;
        };
        var Prev: TraceAct = last;
        conclude : true with ({
            last = +obj : TraceAct (
                {
                    hasAction(callAction);
                    (callAction=>hasValue()) ? hasValue(actionValue);
                }
            );
            if (callAction=>hasValue()) actionValue.used = true;
            Prev +=> directlyBeforeOf(last);
        });
    };
    // Иначе, P и есть последнее корректное действие для поиска следующего
    conclude : null;
}

fragment unwindNewConstruct(C: ConcreteConstruct) {
    var A: ConcreteAction = find ConcreteAction c {
        $c->derivedFrom.role == "BEGIN" and $c->belongsTo == C
    } out true else { conclude : error [exception = true;];};
    var Prev: TraceAct = findExtreme lastAct [not $lastAct=>beforeOf($a)] among TraceAct a {true};
    var actionValue: SemanticValue = findUnusedValue(N) {
        true, false -> out;
    };
    conclude : null with ({
        // Сначала само действие
        L = +obj : TraceAct (
            {
                hasAction(N);
                hasTransition(T);
                (N=>hasValue()) ? hasValue(actionValue);
            }
        );
        Prev +=> directlyBeforeOf(L);
        Prev = L;
        if (N=>hasValue()) actionValue.used = true;
        // Затем то, во что оно разворачивается (BEGIN нового конструкта)
        L = +obj : TraceAct (
            {
                hasAction(A);
            }
        );
        Prev +=> directlyBeforeOf(L);
        applyInterruptionMode(T, S);
    });
}

fragment classifyAction(N: ConcreteAction) {
    // если действие является непрозрачным
    ask (N->derivedFrom.is_opaque) {
        true -> {
            var C: ConcreteConstruct = find ConcreteConstruct c {$c.ast_id == N.ast_id} {
                true -> {
                    // если действие разворачивается в новый конструкт, то его первое прозрачное действие и есть следующее действие
                    `fragment`:unwindNewConstruct(C);
                }
                false -> {
                    // иначе, следующее действие - это само действие N, без раскрытия в конструкт
                    var Prev: TraceAct = findExtreme lastAct [not $lastAct=>beforeOf($a)] among TraceAct a {true};
                    var actionValue: SemanticValue = findUnusedValue(N) {
                        true, false -> out;
                    };
                    conclude : true with ({
                        P = +obj : TraceAct (
                            {
                                hasAction(N);
                                (N=>hasValue()) ? hasValue(actionValue);
                                hasTransition(T);
                            }
                        );
                        if (N=>hasValue()) actionValue.used = true;
                        applyInterruptionMode(T, S);
                        Prev +=> directlyBeforeOf(P);
                        L = P
                    });
                }
            };
        }
        false -> {
            // Для прозрачного действия тоже нужно продвинуть трассу вперед
            var C: ConcreteConstruct = find ConcreteConstruct c {$c.ast_id == N.ast_id and N->derivedFrom.role != "END" and N->derivedFrom.role != "BEGIN"} {
                true -> {
                    // если ПРОЗРАЧНОЕ действие (кроме BEGIN и END, это нужно для поддержки произвольных прозрачных действий) разворачивается в новый конструкт, то его первое прозрачное действие и есть следующее действие
                    `fragment`:unwindNewConstruct(C);
                }
                false -> {
                    // если не новый конструкт, то просто оставляем действие
                    var Prev: TraceAct = findExtreme lastAct [not $lastAct=>beforeOf($a)] among TraceAct a {true};
                    var actionValue: SemanticValue = findUnusedValue(N) {
                        true, false -> out;
                    };
                    conclude: null with ({
                        L = +obj : TraceAct (
                            {
                                hasAction(N);
                                (N=>hasValue()) ? hasValue(actionValue);
                                hasTransition(T);
                            }
                        );
                        if (N=>hasValue()) actionValue.used = true;
                        applyInterruptionMode(T, S);
                        Prev +=> directlyBeforeOf(L);
                    });
                }
            };
            // продолжаем искать ответ уже от нового прозрачного действия
        }
    };
}

fragment checkRepeatedAction(N: ConcreteAction) {
    // Если действия уже было в трассе
    ask (forAny TraceAct t {$t->hasAction == N}) out false else {
        // Проверяем, является ли действие повторяемым и выбираем следующее возможное действие из цепочки
        var N1: ConcreteAction = find ConcreteAction n {$n=>afterOf(N) 
            and not (forAny TraceAct t {$t->hasAction == $n}) 
            and $n=>isCloserToThan(
                N,
                findExtreme lastN [not $lastN=>beforeOf($c)] among ConcreteAction c {$c=>afterOf(N)}
            )
        } out true else {
            `fragment`:classifyAction(N);
        };
        `fragment`:classifyAction(N1);
    };
    `fragment`:classifyAction(N);
}

tpg CtrlFlow_findCorrect(S: TraceState, P: TraceAct) {
    // L - точка отсчета для рассуждения о следующем, P - предыдущее корректное действие
    var L: TraceAct = P;
    // Пока не найдем следующее корректное НЕПРОЗРАЧНОЕ действие
    while (not L->hasAction->derivedFrom.is_opaque or L == P) {
        body -> {
            // если конец программы, то искать ничего не нужно
            ask (L->hasAction->belongsTo->derivedFrom.name == "global_statements_structure" 
                and L->hasAction->derivedFrom.role == "END") out false else {
                conclude: true with (P = L) [
                    // все вычислено
                ];
            };

            `fragment`:findLastTracedAction(L) out true, null; // присоединяем выходы true, null из фрагмента в этот поток
        
            // Ищем переход внутри конструкта последнего действия, который соответствует условиям прерывания, значения условия
            var T: TransitionSpec = find TransitionSpec t {
                $t->from_ == L->hasAction->derivedFrom and
                $t->belongsTo == L->hasAction->belongsTo->derivedFrom and
                (not $t=>hasConstraints() or (
                    S.interruption_mode == $t->hasConstraints.interruption_mode 
                    or $t->hasConstraints.interruption_mode == InterruptionType:any
                )) and (not L=>hasValue() or 
                    findUnusedValue(L->hasAction).bool_value == $t->hasConstraints.condition_value
                )
            } out true else {conclude : error [exception = true; exceptionName = "AmbiguousOrMissingTransition";];};

            // По найденному переходу ищем конкретное действие
            var N: ConcreteAction = find ConcreteAction a {
                $a != L->hasAction and
                $a->derivedFrom == T->to_ and
                $a->belongsTo == L->hasAction->belongsTo and
                (
                    not L->hasAction=>directlyBeforeOf() // либо действие не в цепочке, либо выбираем такое, которое сразу после L
                    or ( // если вдруг одни и те же действия идут подряд в одной цепочке
                        $a=>afterOf(L->hasAction) and
                        not forAny ConcreteAction mid {
                            $mid != $a and
                            $mid->derivedFrom == T->to_ and
                            $mid->belongsTo == $a->belongsTo and
                            $mid=>afterOf(L->hasAction) and
                            $a=>afterOf($mid)
                        }
                    )
                    or ( // если вдруг мы возвращаемся в действие назад, которое ранее проходили, и у него например есть не used значения
                        not T=>to_when_absent() and // без него в завершении однотипных действий (например, блок statement) неправильно выбирает действие, правильно ли??
                        not forAny ConcreteAction fwd {
                            $fwd->derivedFrom == T->to_ and
                            $fwd->belongsTo == L->hasAction->belongsTo and
                            $fwd=>afterOf(L->hasAction)
                        }
                    )
                )
            } out true else {
                // Если для основного target role нет concrete-action, пробуем fallback
                // из TransitionSpec.to_when_absent. Это общий механизм для branch/END
                // и других случаев, когда переход определен, но прямой цели в AST нет.
                var N_absent: ConcreteAction = find ConcreteAction a {
                    $a != L->hasAction and
                    forAny ActionSpec absent {
                        $absent == T->to_when_absent and
                        $a->derivedFrom == $absent
                    } and
                    $a->belongsTo == L->hasAction->belongsTo and
                    (
                        not L->hasAction=>directlyBeforeOf()
                        or (
                            $a=>afterOf(L->hasAction) and
                            not forAny ConcreteAction mid {
                                $mid != $a and
                                forAny ActionSpec absent {
                                    $absent == T->to_when_absent and
                                    $mid->derivedFrom == $absent
                                } and
                                $mid->belongsTo == $a->belongsTo and
                                $mid=>afterOf(L->hasAction) and
                                $a=>afterOf($mid)
                            }
                        )
                    )
                } out true else {conclude : error [exception = true; exceptionName = "NoNextAction";];};
                `fragment`:checkRepeatedAction(N_absent);
            };
            `fragment`:checkRepeatedAction(N);
        }
        true, false -> {
            conclude : true;
        }
        null -> {
            conclude : false [exception=true;];
        }
    };
}
