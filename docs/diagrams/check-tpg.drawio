        <object label="Внутреннее&lt;br&gt;исключение&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;рассуждателя&lt;/font&gt;" tpgKind="LegendSample" id="lg_exc">
