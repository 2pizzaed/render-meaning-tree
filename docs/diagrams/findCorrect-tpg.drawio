        <object label="&lt;b&gt;Остановиться перед &lt;/b&gt;&lt;font color=&quot;#009900&quot;&gt;непрозрачным&lt;/font&gt;&lt;b&gt; BEGIN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;этот шаг должен выбрать студент&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgExpr="conclude : true;" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_res_prerun">
