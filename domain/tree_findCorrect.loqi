fragment findLastTracedAction(last: TraceAct) {
    // фрагмент поиска "реального" последнего действия, от которого будет происходить дальнейший поиск следующего корректного

    // последнее вычисленное действие является END в его конструкте
    ask (P->hasAction->derivedFrom.role == "END") out false else {
        // ищем еще незаверщенное действие конструкта, который ближе к P
        var possibleLast: TraceAct = find TraceAct t {
            $t=>isCloserToThan(P, 
                findExtreme first [not $first=>afterOf($c)] among TraceAct c {true}
            ) and $t->hasAction->derivedFrom.role != "END" and 
            not forAny TraceAct t2 {
                $t2->hasAction.ast_id == $t->hasAction.ast_id and 
                $t2->hasAction->derivedFrom.role == "END" and 
                $t2=>afterOf($t)
            }
        } out true else {conclude : error [exception = true;];};
        // Если последнее действие это корень программы, то всё в программе вычислено. Создадим новый акт завершения
        ask (possibleLast->hasAction->belongsTo->derivedFrom.name == "global_statements_structure") out false else {
            conclude : true with (last = +obj : TraceAct (
                {
                    hasAction(find ConcreteAction a {
                        $a->belongsTo->derivedFrom.name == "global_statements_structure" and
                        $a->derivedFrom.role == "END"
                    });
                    hasTransition(find TransitionSpec t {
                        $t->from_ == possibleLast->hasAction->derivedFrom and
                        $t->belongsTo == possibleLast->hasAction->belongsTo->derivedFrom
                    });
                    hasValue(possibleLast->hasValue);
                    directlyBeforeOf(P);
                }
            ));
        };
        conclude: true with (last = possibleLast);
    };
    // Если последнее действие - это добавление в стек вызовов (прыжок в функцию)
    ask (
        P->hasTransition=>hasEffects() and 
        P->hasTransition->hasEffects.call_stack != CallStackAction:none
    ) out false else {
        // Ищем начало тела функции и создаем акт вызова функции
        var callAction: ConcreteAction = find ConcreteAction a {
            $a->derivedFrom.role == "BEGIN" and
            $a.ast_id == P->hasAction.ast_id
        } out true else {conclude : error [exception = true;];};
        conclude : true with (last = +obj : TraceAct (
            {
                hasAction(callAction);
                hasValue(callAction->hasValue);
                directlyBeforeOf(P);
            }
        ));
    };
    // Иначе, P и есть последнее корректное действие для поиска следующего
    conclude : null;
}

fragment classifyAction(N: ConcreteAction) {
    // если действие является непрозрачным
    ask (N->derivedFrom.is_opaque) {
        true -> {
            var C: ConcreteConstruct = find ConcreteConstruct c {$c.ast_id == N.ast_id} {
                true -> {
                    // если действие разворачивается в новый конструкт, то его первое прозрачное действие и есть следующее действие
                    var A: ConcreteAction = find ConcreteAction c {
                        $c->derivedFrom.role == "BEGIN" and $c->belongsTo == C
                    } out true else { conclude : error [exception = true;];};
                    conclude : true with ({L = +obj : TraceAct (
                        {
                            hasAction(A);
                            (A=>hasValue()) ? hasValue(A->hasValue);
                            directlyBeforeOf(L);
                        }
                    ); P = L});
                }
                false -> {
                    // иначе, следующее действие - это само действие N, без раскрытия в конструкт
                    conclude : true with ({L = +obj : TraceAct (
                        {
                            hasAction(N);
                            (N=>hasValue()) ? hasValue(N->hasValue);
                            hasTransition(T);
                            directlyBeforeOf(L);
                        }
                    ); P = L});
                }
            };
        }
        false -> {
            conclude: null;
            // продолжаем искать ответ
        }
    };
}

tpg CtrlFlow_findCorrect(S: TraceState, P: TraceAct) {
    var L: TraceAct = P; // точка отсчета - P - предыдущее корректное действие
    // Пока не найдем следующее корректное НЕПРОЗРАЧНОЕ действие
    while (L->hasAction->derivedFrom.is_opaque or L == P) {
        body -> {
            `fragment`:findLastTracedAction(L) out true, null; // присоединяем выходы true, null из фрагмента в этот поток

            // если конец программы, то искать ничего не нужно
            ask (L->hasAction->belongsTo->derivedFrom.name == "global_statements_structure" 
                and L->hasAction->derivedFrom.role == "END") out false else {
                conclude: true with (P = L) [
                    // все вычислено
                ];
            };

            // Ищем переход внутри конструкта последнего действия, который соответствует условиям прерывания, значения условия
            var T: TransitionSpec = find TransitionSpec t {debug:trace(
                $t->from_ == L->hasAction->derivedFrom and
                $t->belongsTo == L->hasAction->belongsTo->derivedFrom and
                (not $t=>hasConstraints() or (
                    S.interruption_mode == $t->hasConstraints.interruption_mode 
                    or $t->hasConstraints.interruption_mode == InterruptionType:any
                )) and (not L=>hasValue() or (find SemanticValue v {
                    $v=>afterOf(L->hasValue) and 
                    not $v.used and 
                    $v=>isCloserToThan(
                        L->hasValue, 
                        findExtreme lastV [not $lastV=>beforeOf($c)] among SemanticValue c {
                            $c=>afterOf(L->hasValue)}
                    )
                }).bool_value == $t->hasConstraints.condition_value)
            )} out true else {conclude : error [exception = true; exceptionName = "AmbiguousTransition";];};

            // По найденному переходу ищем конкретное действие
            var N: ConcreteAction = find ConcreteAction a {
                $a != L->hasAction and
                $a->derivedFrom == T->to_ and
                $a->belongsTo == L->hasAction->belongsTo and
                (
                    not L->hasAction=>directlyBeforeOf() // либо действие не в цепочке, либо выбираем такое, которое сразу после L
                    or (
                        $a=>afterOf(L->hasAction) and
                        not forAny ConcreteAction mid {
                            $mid != $a and
                            $mid->derivedFrom == T->to_ and
                            $mid->belongsTo == $a->belongsTo and
                            $mid=>afterOf(L->hasAction) and
                            $a=>afterOf($mid)
                        }
                    )
                )
            } out true else {conclude : error [exception = true; exceptionName = "NoNextAction";];};

            // Если действия уже было в трассе
            ask (forAny TraceAct t {$t->hasAction == N}) out false else {
                // Проверяем, является ли действие повторяемым и выбираем следующее возможное действие из цепочки
                var N1: ConcreteAction = find ConcreteAction n {$n=>afterOf(N) 
                    and not (forAny TraceAct t {$t->hasAction == $n}) 
                    and $n=>isCloserToThan(
                        N,
                        findExtreme lastN [not $lastN=>beforeOf($c)] among ConcreteAction c {$c=>afterOf(N)}
                    )
                } out true else {conclude : error [exception = true; exceptionName = "NoChainedAction";];};
                `fragment`:classifyAction(N1);
            };
            `fragment`:classifyAction(N);
        }
        true, false -> {
            conclude : true;
        }
        null -> {
            conclude : false [exception=true;];
        }
    };
}