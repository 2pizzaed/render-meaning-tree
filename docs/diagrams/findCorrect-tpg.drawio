        <object label="&lt;b&gt;Действия&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &amp;lt;ограничения&amp;gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;класс&lt;/font&gt;&amp;gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Добавить&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; в трассу&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Применить&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;эффект&lt;/font&gt;&amp;gt; к &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;состоянию трассировки&lt;/font&gt;&amp;gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Раскрыть&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;&amp;gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Типы вопросов&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Является ли&lt;/font&gt; &amp;lt;объект&amp;gt; &amp;lt;&lt;font color=&quot;#009900&quot;&gt;свойство&lt;/font&gt;&amp;gt;?&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;bool: Да / Нет&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Достигнут ли&lt;/font&gt; &amp;lt;объект&amp;gt;?&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;bool: Да / Нет&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Есть ли&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;ограничение&lt;/font&gt;&amp;gt;?&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;bool: Да / Нет&lt;/font&gt;" tpgKind="Dictionary" tpgDict="Actions and question types" tpgHint="словарь формулировок; собственных LOQI-деклараций не имеет" id="n_acts">
