        <object label="&lt;b&gt;Действия&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &amp;lt;ограничения&amp;gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;класс&lt;/font&gt;&amp;gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Добавить&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; в трассу&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Применить&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;эффект&lt;/font&gt;&amp;gt; к &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;состоянию трассировки&lt;/font&gt;&amp;gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Достроить&lt;/font&gt; прозрачные &lt;font color=&quot;#CC0066&quot;&gt;действия&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Типы вопросов&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Является ли&lt;/font&gt; &amp;lt;объект&amp;gt; &amp;lt;&lt;font color=&quot;#009900&quot;&gt;свойство&lt;/font&gt;&amp;gt;?&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;bool: Да / Нет&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Возможен ли&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt;&amp;gt; из &amp;lt;объекта&amp;gt; в &amp;lt;объект&amp;gt;?&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Совпадают ли&lt;/font&gt; &amp;lt;объект&amp;gt; и &amp;lt;объект&amp;gt;?&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;bool: Да / Нет&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Завершена ли&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкция&lt;/font&gt;&amp;gt;?&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;bool: Да / Нет&lt;/font&gt;" tpgKind="Dictionary" tpgDict="Actions and question types" tpgHint="словарь формулировок; собственных LOQI-деклараций не имеет" id="n_acts">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=16;" vertex="1">
            <mxGeometry height="270" width="620" x="500" y="554" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Цвета терминов&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt;, &lt;font color=&quot;#3333CC&quot;&gt;Является ли&lt;/font&gt; — действие или ключевое слово вопроса&lt;br&gt;&lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;, &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;, &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt; — класс&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;непрозрачность&lt;/font&gt;, &lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt; — свойство объекта и его значения&lt;br&gt;&lt;font color=&quot;#0099A8&quot;&gt;принадлежит&lt;/font&gt;, &lt;font color=&quot;#0099A8&quot;&gt;вложен в&lt;/font&gt; — отношение между объектами&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;A&lt;/font&gt;, &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt;, &lt;font color=&quot;#B38F00&quot;&gt;C&lt;/font&gt;, &lt;font color=&quot;#B38F00&quot;&gt;D_a&lt;/font&gt;, &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt; — переменная графа&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;свойств класса в этом домене нет (для них зарезервирован &lt;/font&gt;&lt;font color=&quot;#E67300&quot;&gt;оранжевый&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;)&lt;/font&gt;" tpgKind="Legend" tpgLegend="term colors" id="n_legend">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=16;" vertex="1">
            <mxGeometry height="180" width="620" x="500" y="854" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Отношения между объектами&lt;/b&gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;относится к&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действию&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;выполнен по&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правилу перехода&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;&amp;gt;, &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;имеет&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;значение времени выполнения&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;1&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;непосредственно перед&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;2&amp;gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(шкала: линейная; производные: &lt;/font&gt;&lt;font color=&quot;#0099A8&quot;&gt;перед&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;, &lt;/font&gt;&lt;font color=&quot;#0099A8&quot;&gt;между&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;, &lt;/font&gt;&lt;font color=&quot;#0099A8&quot;&gt;ближе к&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;)&lt;/font&gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;1&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;непосредственно перед&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;2&amp;gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(шкала: линейная)&lt;/font&gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;принадлежит&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкту&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;порождено&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правилом действия&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;порождён&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правилом конструкта&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;1&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;вложен в&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt;2&amp;gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(частичная шкала; транзитивное: &lt;/font&gt;&lt;font color=&quot;#0099A8&quot;&gt;предок&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;)&lt;/font&gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило перехода&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;ведёт из&lt;/font&gt; / &lt;font color=&quot;#0099A8&quot;&gt;ведёт в&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило действия&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило перехода&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;при отсутствии цели ведёт в&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;цепочку правил действий&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило перехода&lt;/font&gt;&amp;gt;, &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило действия&lt;/font&gt;&amp;gt;, &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;имеет&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;эффект&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило перехода&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;имеет&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;ограничение&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правило конструкта&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;содержит&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правила действий&lt;/font&gt;&amp;gt;, &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;правила переходов&lt;/font&gt;&amp;gt;&lt;br&gt;&amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;&amp;gt; &lt;font color=&quot;#0099A8&quot;&gt;раскрыт из&lt;/font&gt; &amp;lt;&lt;font color=&quot;#CC0066&quot;&gt;действия&lt;/font&gt;&amp;gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(только у BEGIN-акта развёрнутого конструкта)&lt;/font&gt;" tpgKind="Dictionary" tpgDict="Relationships between objects" tpgHint="TraceAct: hasAction(ConcreteAction) {*-&gt;1}, hasTransition(TransitionSpec) {*-&gt;1}, hasValue(SemanticValue), directlyBeforeOf(TraceAct): linear (+opposite directlyAfterOf, transitive beforeOf/afterOf, between isBetween, closer isCloserToThan, further isFurtherFromThan); ConcreteAction: belongsTo(ConcreteConstruct) {*-&gt;1}, derivedFrom(ActionSpec) {*-&gt;1}, hasEffects(Effect) {*-&gt;1}, directlyBeforeOf(ConcreteAction): linear; ConcreteConstruct: hasActions {1-&gt;*}, derivedFrom(ConstructSpec) {*-&gt;1}, hasParent(ConcreteConstruct): partial, hasAncestor: transitive to hasParent; TransitionSpec: from_(ActionSpec), to_(ActionSpec) {*-&gt;1}, to_when_absent(ActionSpecChainPlaceholder) {*-&gt;1}, belongsTo(ConstructSpec) {*-&gt;1}, hasConstraints(Constraint) {*-&gt;1}, hasEffects(Effect) {*-&gt;1}; ActionSpec: belongsTo, hasEffects; ConstructSpec: hasActions {1-&gt;*}, hasTransitions {1-&gt;*}; TraceAct.unfoldedFrom(ConcreteAction) : {* -&gt; 1}" id="n_rels">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=16;" vertex="1">
            <mxGeometry height="400" width="700" x="1140" y="100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Как читать результаты&lt;/b&gt;&lt;br&gt;&lt;b&gt;Зелёный&lt;/b&gt; — ответ студента засчитан: &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; добавлено в трассу.&lt;br&gt;&lt;b&gt;Красный с диагнозом&lt;/b&gt; — распознанная ошибка студента. Под формулировкой серым стоит идентификатор умения, по которому тренажёр учитывает ошибку.&lt;br&gt;&lt;b&gt;Красный с пометкой «внутреннее исключение»&lt;/b&gt; — не ошибка студента, а невозможная ситуация в самом рассуждателе.&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" tpgKind="Documentation" id="n_conv">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=16;" vertex="1">
            <mxGeometry height="220" width="700" x="1140" y="534" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Задача графа&lt;/b&gt;&lt;br&gt;Студент строит трассу выполнения программы по шагам. Граф отвечает на вопрос: &lt;b&gt;может ли выбранное действие быть выполнено прямо сейчас&lt;/b&gt;, и если нет — почему.&lt;br&gt;&lt;br&gt;&lt;b&gt;Дано:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;S&lt;/font&gt; — &lt;font color=&quot;#CC0066&quot;&gt;состояние трассировки&lt;/font&gt; (текущий &lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt;);&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt; — последний корректный &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt; (всё, что в трассе, уже засчитано как верное);&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;A&lt;/font&gt; — &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;, выбранное студентом на этом шаге.&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;correct&lt;/b&gt; — &lt;font color=&quot;#B38F00&quot;&gt;A&lt;/font&gt; может быть выполнено: оно добавляется в трассу с &lt;font color=&quot;#CC0066&quot;&gt;переходом&lt;/font&gt;, &lt;font color=&quot;#CC0066&quot;&gt;эффектами&lt;/font&gt; и израсходованным &lt;font color=&quot;#009900&quot;&gt;значением условия&lt;/font&gt;;&lt;br&gt;• &lt;b&gt;error&lt;/b&gt; с диагнозом — &lt;font color=&quot;#B38F00&quot;&gt;A&lt;/font&gt; выполнить нельзя, и граф называет причину;&lt;br&gt;• &lt;b&gt;error&lt;/b&gt; с пометкой исключения — рассуждатель зашёл в невозможную ситуацию.&lt;br&gt;&lt;br&gt;Эталонной трассы у графа нет: корректность выводится из правил домена и уже построенной части трассы." tpgKind="Documentation" id="n_task">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=16;" vertex="1">
            <mxGeometry height="460" width="620" x="1860" y="100" as="geometry" />
          </mxCell>
        </object>
