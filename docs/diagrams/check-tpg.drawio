        <object label="Пунктирная рамка: результат передаётся наружу —&lt;br&gt;в объемлющий цикл" tpgKind="LegendText" id="lg_up_t">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;" vertex="1">
