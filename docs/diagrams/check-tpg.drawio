<mxfile host="Electron" agent="visualize-thought-process-graph">
  <diagram id="check" name="Граф проверок выбранного действия">
    <mxGraphModel dx="3084" dy="1828" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object label="&lt;b&gt;Уточнение ошибки:&lt;/b&gt; пред-прогон сам увёл выполнение из &lt;font color=&quot;#CC0066&quot;&gt;конструкции&lt;/font&gt; с выбранным &lt;font color=&quot;#CC0066&quot;&gt;действием&lt;/font&gt;&amp;nbsp;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size: 16px;&quot;&gt;autoPassedRefinement&lt;/font&gt;" tpgKind="Fragment" tpgProcedure="fragment autoPassedRefinement()" tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" tpgNote="вызывается как `fragment`:autoPassedRefinement() out null; исход null продолжает основной поток, correct/error терминальны" id="g_auto">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;collapsible=0;movable=1;resizable=1;fontSize=20;" vertex="1">
            <mxGeometry height="597" width="1210" x="1000" y="2525" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Вывело ли&lt;/font&gt; сработавшее &lt;font color=&quot;#009900&quot;&gt;прерывание&lt;/font&gt; выполнение из &lt;font color=&quot;#CC0066&quot;&gt;конструкции&lt;/font&gt; с выбранным &lt;font color=&quot;#CC0066&quot;&gt;действием&lt;/font&gt; уже после шага студента?" tpgKind="QuestionNode" tpgExpr="forAny TraceAct t {&#10;    $t=&gt;afterOf(P0) and&#10;    $t-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot; and&#10;    isAncestorOrSelf(A-&gt;belongsTo, $t-&gt;hasAction-&gt;belongsTo) and&#10;    not $t=&gt;hasTransition()&#10;}" tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" tpgNote="вынужденный выход findCorrect добавляет БЕЗ перехода — это отличает его от выхода по значению условия" id="ck_q_forced">
          <mxCell parent="g_auto" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="210" width="440" x="40" y="52" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Прерывание не было учтено студентом&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size: 16px;&quot;&gt;interruption_not_considered&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="interruption_not_considered" tpgRuExplanation="Нельзя выполнить это действие: сработавшее прерывание уже вывело выполнение из этой конструкции." tpgEnExplanation="This action cannot be performed: the triggered interruption has already taken execution out of this construct." tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" id="ck_e_forced">
          <mxCell parent="g_auto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;" vertex="1">
            <mxGeometry height="150" width="300" x="870" y="82" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Покинуло ли&lt;/font&gt; выполнение эту &lt;font color=&quot;#CC0066&quot;&gt;конструкцию&lt;/font&gt; или ушло в другую её ветвь уже после шага студента?" tpgKind="QuestionNode" tpgExpr="forAny TraceAct t {&#10;    $t=&gt;afterOf(P0) and (&#10;        (&#10;            $t-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot; and&#10;            isAncestorOrSelf(A-&gt;belongsTo, $t-&gt;hasAction-&gt;belongsTo)&#10;        ) or (&#10;            $t-&gt;hasAction-&gt;derivedFrom.role == &quot;BEGIN&quot; and&#10;            $t-&gt;hasAction.ast_id != A.ast_id and&#10;            $t-&gt;hasAction-&gt;belongsTo=&gt;hasParent(A-&gt;belongsTo) and&#10;            forAny ConcreteAction sibling {&#10;                $sibling-&gt;belongsTo == A-&gt;belongsTo and&#10;                $sibling != A and&#10;                $sibling.ast_id == $t-&gt;hasAction.ast_id&#10;            }&#10;        )&#10;    )&#10;}" tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" tpgNote="другая ветвь — конструкт, раскрытый действием того же уровня, отличным от A; вход в тело вызванной функции ветвью не считается" id="ck_q_other">
          <mxCell parent="g_auto" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="210" width="380" x="70" y="357" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Выполнение уже пошло по другому пути ветвления&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size: 16px;&quot;&gt;condition_value_not_considered&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="condition_value_not_considered" tpgRuExplanation="Нельзя выполнить это действие: не учтено вычисленное значение условия — выполнение уже пошло по другому пути." tpgEnExplanation="This action cannot be performed: the evaluated condition value is not taken into account — execution has already taken a different path." tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" id="ck_e_other">
          <mxCell parent="g_auto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;" vertex="1">
            <mxGeometry height="120" width="260" x="890" y="402" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Засчитать действие: добавить его в трассу&lt;/b&gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;commitCorrectAction&lt;/font&gt;" tpgKind="Fragment" tpgProcedure="fragment commitCorrectAction()" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" tpgAdaptation="служебный узел var Prev: TraceAct = findExtreme lastAct … (последний акт трассы) не показан отдельным узлом; он используется в выражениях эффектов результатов" id="g_commit">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;collapsible=0;movable=1;resizable=1;fontSize=20;" vertex="1">
            <mxGeometry height="1102" width="1840" x="3404" y="3054" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; роль &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt; на уровне &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt; выбранного &lt;font color=&quot;#CC0066&quot;&gt;действия&lt;/font&gt; — источник &lt;font color=&quot;#CC0066&quot;&gt;перехода&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;DpFin&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="DpFin: ConcreteAction" tpgExpr="roleActionOf(P-&gt;hasAction, A-&gt;belongsTo)" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_dpfin">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="150" width="280" x="570" y="52" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; в выбранное &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;, удовлетворяющий &lt;font color=&quot;#009900&quot;&gt;режиму прерывания&lt;/font&gt; и &lt;font color=&quot;#009900&quot;&gt;значению условия&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;Tin&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="Tin: TransitionSpec" tpgExpr="find TransitionSpec t {&#10;    transitionLeads($t, DpFin, A, A-&gt;belongsTo) and&#10;    interruptionOk($t, S) and&#10;    conditionOk($t, DpFin)&#10;}&#10;&#10;// lambda transitionLeads(t, fromA, toA, C) =&#10;//     t-&gt;belongsTo == C-&gt;derivedFrom and t-&gt;from_ == fromA-&gt;derivedFrom and&#10;//     ( t-&gt;to_ == toA-&gt;derivedFrom or (&#10;//         (not forAny ConcreteAction primary {&#10;//             $primary-&gt;belongsTo == C and $primary-&gt;derivedFrom == t-&gt;to_ }) and&#10;//         toWhenAbsent(t, C) == toA-&gt;derivedFrom ) );&#10;// lambda interruptionOk(t, S) = not t=&gt;hasConstraints() or&#10;//     t-&gt;hasConstraints.interruption_mode == S.interruption_mode or&#10;//     t-&gt;hasConstraints.interruption_mode == InterruptionType:any;&#10;// lambda conditionOk(t, fromA) = not t=&gt;hasConstraints() or not fromA=&gt;hasValue() or&#10;//     findUnusedValue(fromA).bool_value == t-&gt;hasConstraints.condition_value;" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_tin">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="150" width="300" x="560" y="291" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt; с &lt;font color=&quot;#009900&quot;&gt;прозрачным&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;, который раскрывается выбранным &lt;font color=&quot;#CC0066&quot;&gt;действием&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;кроме раскрываемых раньше своего действия&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;ExpandsNT&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="ExpandsNT: ConcreteConstruct" tpgExpr="find ConcreteConstruct cc {&#10;    A-&gt;derivedFrom.role != &quot;BEGIN&quot; and&#10;    A-&gt;derivedFrom.role != &quot;END&quot; and&#10;    $cc != A-&gt;belongsTo and&#10;    $cc.ast_id == A.ast_id and&#10;    not $cc-&gt;derivedFrom.preorder and&#10;    not beginActionOf($cc)-&gt;derivedFrom.is_opaque&#10;}" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_expands_nt">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="190" width="300" x="144" y="451" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt; с &lt;font color=&quot;#009900&quot;&gt;прозрачным&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;, который раскрывается выбранным &lt;font color=&quot;#CC0066&quot;&gt;действием&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;кроме раскрываемых раньше своего действия&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;Expands&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="Expands: ConcreteConstruct" tpgExpr="find ConcreteConstruct cc {&#10;    A-&gt;derivedFrom.role != &quot;BEGIN&quot; and&#10;    A-&gt;derivedFrom.role != &quot;END&quot; and&#10;    $cc != A-&gt;belongsTo and&#10;    $cc.ast_id == A.ast_id and&#10;    not $cc-&gt;derivedFrom.preorder and&#10;    not beginActionOf($cc)-&gt;derivedFrom.is_opaque&#10;}" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_expands">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="190" width="300" x="1174" y="552" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие засчитано&lt;/b&gt;&lt;br&gt;в трассу добавлены действие и &lt;font color=&quot;#009900&quot;&gt;прозрачный&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; раскрываемого &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt; правила действия&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;сброшено&lt;/font&gt; «&lt;font color=&quot;#009900&quot;&gt;использовано&lt;/font&gt;» у &lt;font color=&quot;#CC0066&quot;&gt;значений времени выполнения&lt;/font&gt; раскрываемого &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt; и его &lt;font color=&quot;#0099A8&quot;&gt;потомков&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;correct_answer&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgSkill="correct_answer" tpgRuExplanation="Действие может быть выполнено следующим и добавлено в трассу." tpgEnExplanation="The action can be performed next and is appended to the trace." tpgEffect="P = +obj : TraceAct ({&#10;    hasAction(A);&#10;    (A=&gt;hasValue()) ? hasValue(findUnusedValue(A));&#10;});&#10;Prev +=&gt; directlyBeforeOf(P);&#10;if (A=&gt;hasValue()) P-&gt;hasValue.used = true;&#10;if (A-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(A-&gt;derivedFrom-&gt;hasEffects, S);&#10;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S);&#10;Prev = P;&#10;P = +obj : TraceAct ({ hasAction(beginActionOf(ExpandsNT)); });&#10;Prev +=&gt; directlyBeforeOf(P);&#10;resetUsedValues(ExpandsNT);&#10;if (beginActionOf(ExpandsNT)-&gt;derivedFrom=&gt;hasEffects())&#10;    applyInterruptionMode(beginActionOf(ExpandsNT)-&gt;derivedFrom-&gt;hasEffects, S);&#10;if (beginActionOf(ExpandsNT)=&gt;hasEffects())&#10;    applyInterruptionMode(beginActionOf(ExpandsNT)-&gt;hasEffects, S)&#10;// lambda resetUsedValues(C) = forAll SemanticValue v [&#10;//     forAny ConcreteAction a { ($a-&gt;belongsTo == C or $a-&gt;belongsTo=&gt;hasAncestor(C)) and&#10;//         $a=&gt;hasValue() and ($v == $a-&gt;hasValue or $v=&gt;afterOf($a-&gt;hasValue)) }&#10;// ] { $v.used = false };" tpgExpr="conclude: correct with ({ … });" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_r_nt_both">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;" vertex="1">
            <mxGeometry height="256" width="380" x="30" y="802" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие засчитано&lt;/b&gt;&lt;br&gt;в трассу добавлено только действие &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(перехода к нему нет — вход по &lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;&lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt; или выход при прерывании)&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt; правила действия&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;у BEGIN-акта запомнено действие, из которого раскрыт конструкт&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;у выбранного BEGIN сброшено «использовано» у значений его конструкта и потомков&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;correct_answer&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgSkill="correct_answer" tpgRuExplanation="Действие может быть выполнено следующим и добавлено в трассу." tpgEnExplanation="The action can be performed next and is appended to the trace." tpgEffect="P = +obj : TraceAct ({&#10;    hasAction(A);&#10;    (A-&gt;derivedFrom.role == &quot;BEGIN&quot; and hasUnfoldingAction(A-&gt;belongsTo)) ? unfoldedFrom(unfoldingActionOf(A-&gt;belongsTo));&#10;    (A=&gt;hasValue()) ? hasValue(findUnusedValue(A));&#10;});&#10;Prev +=&gt; directlyBeforeOf(P);&#10;if (A=&gt;hasValue()) P-&gt;hasValue.used = true;&#10;if (A-&gt;derivedFrom.role == &quot;BEGIN&quot;) resetUsedValues(A-&gt;belongsTo);&#10;if (A-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(A-&gt;derivedFrom-&gt;hasEffects, S);&#10;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S)&#10;// lambda resetUsedValues(C) = forAll SemanticValue v [&#10;//     forAny ConcreteAction a { ($a-&gt;belongsTo == C or $a-&gt;belongsTo=&gt;hasAncestor(C)) and&#10;//         $a=&gt;hasValue() and ($v == $a-&gt;hasValue or $v=&gt;afterOf($a-&gt;hasValue)) }&#10;// ] { $v.used = false };" tpgExpr="conclude: correct with ({ … });" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_r_nt_plain">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;" vertex="1">
            <mxGeometry height="270" width="380" x="470" y="802" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие засчитано&lt;/b&gt;&lt;br&gt;в трассу добавлены действие с &lt;font color=&quot;#CC0066&quot;&gt;переходом&lt;/font&gt; и &lt;font color=&quot;#009900&quot;&gt;прозрачный&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; раскрываемого &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;сброшено&lt;/font&gt; «&lt;font color=&quot;#009900&quot;&gt;использовано&lt;/font&gt;» у &lt;font color=&quot;#CC0066&quot;&gt;значений времени выполнения&lt;/font&gt; этого &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt; и его &lt;font color=&quot;#0099A8&quot;&gt;потомков&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;correct_answer&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgSkill="correct_answer" tpgRuExplanation="Действие может быть выполнено следующим и добавлено в трассу." tpgEnExplanation="The action can be performed next and is appended to the trace." tpgEffect="P = +obj : TraceAct ({&#10;    hasAction(A);&#10;    hasTransition(Tin);&#10;    (A=&gt;hasValue()) ? hasValue(findUnusedValue(A));&#10;});&#10;Prev +=&gt; directlyBeforeOf(P);&#10;if (A=&gt;hasValue()) P-&gt;hasValue.used = true;&#10;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S);&#10;if (Tin=&gt;hasEffects()) applyInterruptionMode(Tin-&gt;hasEffects, S);&#10;Prev = P;&#10;P = +obj : TraceAct ({ hasAction(beginActionOf(Expands)); });&#10;Prev +=&gt; directlyBeforeOf(P);&#10;resetUsedValues(Expands);&#10;if (beginActionOf(Expands)-&gt;derivedFrom=&gt;hasEffects())&#10;    applyInterruptionMode(beginActionOf(Expands)-&gt;derivedFrom-&gt;hasEffects, S);&#10;if (beginActionOf(Expands)=&gt;hasEffects())&#10;    applyInterruptionMode(beginActionOf(Expands)-&gt;hasEffects, S)&#10;// lambda resetUsedValues(C) = forAll SemanticValue v [&#10;//     forAny ConcreteAction a { ($a-&gt;belongsTo == C or $a-&gt;belongsTo=&gt;hasAncestor(C)) and&#10;//         $a=&gt;hasValue() and ($v == $a-&gt;hasValue or $v=&gt;afterOf($a-&gt;hasValue)) }&#10;// ] { $v.used = false };" tpgExpr="conclude: correct with ({ … });" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_r_t_both">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;" vertex="1">
            <mxGeometry height="266" width="390" x="930" y="802" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие засчитано&lt;/b&gt;&lt;br&gt;в трассу добавлено действие с &lt;font color=&quot;#CC0066&quot;&gt;переходом&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;по эффекту стека вызовов следующий пред-прогон войдёт в тело функции&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;у BEGIN-акта запомнено действие, из которого раскрыт конструкт&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;у выбранного BEGIN сброшено «использовано» у значений его конструкта и потомков&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;correct_answer&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgSkill="correct_answer" tpgRuExplanation="Действие может быть выполнено следующим и добавлено в трассу." tpgEnExplanation="The action can be performed next and is appended to the trace." tpgEffect="P = +obj : TraceAct ({&#10;    hasAction(A);&#10;    hasTransition(Tin);&#10;    (A-&gt;derivedFrom.role == &quot;BEGIN&quot; and hasUnfoldingAction(A-&gt;belongsTo)) ? unfoldedFrom(unfoldingActionOf(A-&gt;belongsTo));&#10;    (A=&gt;hasValue()) ? hasValue(findUnusedValue(A));&#10;});&#10;Prev +=&gt; directlyBeforeOf(P);&#10;if (A=&gt;hasValue()) P-&gt;hasValue.used = true;&#10;if (A-&gt;derivedFrom.role == &quot;BEGIN&quot;) resetUsedValues(A-&gt;belongsTo);&#10;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S);&#10;if (Tin=&gt;hasEffects()) applyInterruptionMode(Tin-&gt;hasEffects, S)&#10;// lambda resetUsedValues(C) = forAll SemanticValue v [&#10;//     forAny ConcreteAction a { ($a-&gt;belongsTo == C or $a-&gt;belongsTo=&gt;hasAncestor(C)) and&#10;//         $a=&gt;hasValue() and ($v == $a-&gt;hasValue or $v=&gt;afterOf($a-&gt;hasValue)) }&#10;// ] { $v.used = false };" tpgExpr="conclude: correct with ({ … });" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_r_t_plain">
