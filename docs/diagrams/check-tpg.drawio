        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Выбрано ли&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;отложенное&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;, который уже завершился — его &lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt; последний в &lt;font color=&quot;#CC0066&quot;&gt;трассе&lt;/font&gt;?" tpgKind="QuestionNode" tpgExpr="A == Dp and isPendingUnfoldAction(A)&#10;&#10;// lambda isPendingUnfoldAction(target) = forAny TraceAct e {&#10;//     $e-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot; and&#10;//     $e-&gt;hasAction-&gt;belongsTo-&gt;derivedFrom.preorder and&#10;//     $e-&gt;hasAction.ast_id == target.ast_id and&#10;//     not forAny TraceAct later { $later=&gt;afterOf($e) } and&#10;//     forAny TraceAct b { $b-&gt;hasAction-&gt;belongsTo == $e-&gt;hasAction-&gt;belongsTo and&#10;//         $b-&gt;hasAction-&gt;derivedFrom.role == &quot;BEGIN&quot; and $b=&gt;beforeOf($e) and&#10;//         $b-&gt;unfoldedFrom == target } };" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_q_pending">
