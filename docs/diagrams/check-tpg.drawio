п прерывания&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;логическое значение&lt;/font&gt;, &lt;font color=&quot;#009900&quot;&gt;использовано&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;значение времени выполнения&lt;/font&gt;), bool&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;id узла AST&lt;/font&gt;, &lt;font color=&quot;#009900&quot;&gt;тип узла AST&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;сущность AST&lt;/font&gt;), int, string&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;режим прохода непрозрачных действий&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;конфигурация трассировки&lt;/font&gt;), bool&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;раскрывается раньше своего действия&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;правило конструкта&lt;/font&gt;), bool: &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;действие, раскрывшее конструкт, выполняется после его END&lt;/font&gt;" tpgKind="Dictionary" tpgDict="Object properties" tpgHint="ActionSpec: role/generalization/kind: string, is_opaque: bool; ConstructSpec: name/kind: string; Constraint: condition_value: OptionalBool, interruption_mode: InterruptionType; Effect: interruption_start/interruption_stop: InterruptionType, call_stack: CallStackAction; TraceState: interruption_mode; SemanticValue: bool_value/used: bool; ASTEntity: ast_id: int, ast_type: string; TraceConfigSpec: stop_on_opaque: bool; класс-свойств (class prop) в этом домене не объявлено; ConstructSpec: preorder: bool" id="n_props">
