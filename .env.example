MEANING_TREE_CLI_DEBUG=0
TPG_CLI_DEBUG=0
TPG_PLAYGROUND_RUN=0
ITS_DOMAINMODEL_PATH=/path/to/its_DomainModel
ITS_REASONER_PATH=/path/to/its_Reasoner
MEANING_TREE_PATH=/path/to/meaning_tree

# Backend selection: "cli" (subprocess JARs, default) or "rpc" (JSON-RPC server).
TOOLCHAIN_BACKEND=rpc
# MEANING_TREE_BACKEND=rpc
# TPG_BACKEND=rpc

# JSON-RPC server connection (used when the backend is "rpc").
JSON_RPC_TOOLCHAIN_SERVER=http://localhost:9001
# Access secret for the server; leave empty if the server has none.
JSON_RPC_TOOLCHAIN_ACCESS_SECRET=

TOOLCHAIN_SERVER_PATH=/path/to/compph-toolchain-server
JSON_RPC_TOOLCHAIN_PORT=9001
JSON_RPC_TOOLCHAIN_HOST=0.0.0.0
