        <object label="&lt;b&gt;Дано&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;N&lt;/font&gt; — найденное &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;" tpgKind="FragmentInputs" tpgVar="N: ConcreteAction" tpgSource="domain/findCorrect.tpg :: fragment checkRepeatedAction(N: ConcreteAction)" id="a_entry">
