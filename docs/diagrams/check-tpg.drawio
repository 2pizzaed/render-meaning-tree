<mxfile host="Electron" agent="visualize-thought-process-graph">
  <diagram id="check" name="Граф проверок выбранного действия">
    <mxGraphModel dx="2570" dy="1523" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object label="&lt;b&gt;Уточнение: &lt;/b&gt;поиск ошибки после прохождения прозрачных узлов, где конструкт с действием A внезапно был завершен&amp;nbsp;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size: 16px;&quot;&gt;autoPassedRefinement&lt;/font&gt;" tpgKind="Fragment" tpgProcedure="fragment autoPassedRefinement()" tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" tpgNote="вызывается как `fragment`:autoPassedRefinement() out null; исход null продолжает основной поток, correct/error терминальны" id="g_auto">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;collapsible=0;movable=1;resizable=1;fontSize=20;" vertex="1">
            <mxGeometry height="597" width="1500" x="703" y="2525" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Вывело ли&lt;/font&gt; сработавшее &lt;font color=&quot;#009900&quot;&gt;прерывание&lt;/font&gt; выполнение из &lt;font color=&quot;#CC0066&quot;&gt;конструкции&lt;/font&gt; с выбранным &lt;font color=&quot;#CC0066&quot;&gt;действием&lt;/font&gt; уже после шага студента?" tpgKind="QuestionNode" tpgExpr="forAny TraceAct t {&#xa;    $t=&gt;afterOf(P0) and&#xa;    $t-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot; and&#xa;    isAncestorOrSelf(A-&gt;belongsTo, $t-&gt;hasAction-&gt;belongsTo) and&#xa;    not $t=&gt;hasTransition()&#xa;}" tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" tpgNote="вынужденный выход findCorrect добавляет БЕЗ перехода — это отличает его от выхода по значению условия" id="ck_q_forced">
          <mxCell parent="g_auto" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="210" width="440" x="340" y="52" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Прерывание не было учтено студентом&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size: 16px;&quot;&gt;interruption_not_considered&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="interruption_not_considered" tpgRuExplanation="Нельзя выполнить это действие: сработавшее прерывание уже вывело выполнение из этой конструкции." tpgEnExplanation="This action cannot be performed: the triggered interruption has already taken execution out of this construct." tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" id="ck_e_forced">
          <mxCell parent="g_auto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;" vertex="1">
            <mxGeometry height="150" width="300" x="1170" y="82" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Покинуло ли&lt;/font&gt; выполнение эту &lt;font color=&quot;#CC0066&quot;&gt;конструкцию&lt;/font&gt; или ушло в другую её ветвь уже после шага студента?" tpgKind="QuestionNode" tpgExpr="forAny TraceAct t {&#xa;    $t=&gt;afterOf(P0) and (&#xa;        (&#xa;            $t-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot; and&#xa;            isAncestorOrSelf(A-&gt;belongsTo, $t-&gt;hasAction-&gt;belongsTo)&#xa;        ) or (&#xa;            $t-&gt;hasAction-&gt;derivedFrom.role == &quot;BEGIN&quot; and&#xa;            $t-&gt;hasAction.ast_id != A.ast_id and&#xa;            $t-&gt;hasAction-&gt;belongsTo=&gt;hasParent(A-&gt;belongsTo)&#xa;        )&#xa;    )&#xa;}" tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" id="ck_q_other">
          <mxCell parent="g_auto" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="210" width="380" x="370" y="357" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Выполнение уже пошло по другому пути ветвления&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size: 16px;&quot;&gt;condition_value_not_considered&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgSkill="condition_value_not_considered" tpgRuExplanation="Нельзя выполнить это действие: не учтено вычисленное значение условия — выполнение уже пошло по другому пути." tpgEnExplanation="This action cannot be performed: the evaluated condition value is not taken into account — execution has already taken a different path." tpgSource="domain/main.tpg :: fragment autoPassedRefinement()" id="ck_e_other">
          <mxCell parent="g_auto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=20;" vertex="1">
            <mxGeometry height="120" width="260" x="1190" y="402" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Засчитать действие: добавить его в трассу&lt;/b&gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;commitCorrectAction&lt;/font&gt;" tpgKind="Fragment" tpgProcedure="fragment commitCorrectAction()" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" tpgAdaptation="служебный узел var Prev: TraceAct = findExtreme lastAct … (последний акт трассы) не показан отдельным узлом; он используется в выражениях эффектов результатов" id="g_commit">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;collapsible=0;movable=1;resizable=1;fontSize=20;" vertex="1">
            <mxGeometry height="1032" width="1820" x="2990" y="4258" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; роль &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt; на уровне &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt; выбранного &lt;font color=&quot;#CC0066&quot;&gt;действия&lt;/font&gt; — источник &lt;font color=&quot;#CC0066&quot;&gt;перехода&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;DpFin&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="DpFin: ConcreteAction" tpgExpr="roleActionOf(P-&gt;hasAction, A-&gt;belongsTo)" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_dpfin">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="150" width="280" x="570" y="52" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; в выбранное &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;, удовлетворяющий &lt;font color=&quot;#009900&quot;&gt;режиму прерывания&lt;/font&gt; и &lt;font color=&quot;#009900&quot;&gt;значению условия&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;Tin&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="Tin: TransitionSpec" tpgExpr="find TransitionSpec t {&#xa;    transitionLeads($t, DpFin, A, A-&gt;belongsTo) and&#xa;    interruptionOk($t, S) and&#xa;    conditionOk($t, DpFin)&#xa;}&#xa;&#xa;// lambda transitionLeads(t, fromA, toA, C) =&#xa;//     t-&gt;belongsTo == C-&gt;derivedFrom and t-&gt;from_ == fromA-&gt;derivedFrom and&#xa;//     ( t-&gt;to_ == toA-&gt;derivedFrom or (&#xa;//         (not forAny ConcreteAction primary {&#xa;//             $primary-&gt;belongsTo == C and $primary-&gt;derivedFrom == t-&gt;to_ }) and&#xa;//         toWhenAbsent(t, C) == toA-&gt;derivedFrom ) );&#xa;// lambda interruptionOk(t, S) = not t=&gt;hasConstraints() or&#xa;//     t-&gt;hasConstraints.interruption_mode == S.interruption_mode or&#xa;//     t-&gt;hasConstraints.interruption_mode == InterruptionType:any;&#xa;// lambda conditionOk(t, fromA) = not t=&gt;hasConstraints() or not fromA=&gt;hasValue() or&#xa;//     findUnusedValue(fromA).bool_value == t-&gt;hasConstraints.condition_value;" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_tin">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="150" width="300" x="560" y="302" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt; с &lt;font color=&quot;#009900&quot;&gt;прозрачным&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;, который раскрывается выбранным &lt;font color=&quot;#CC0066&quot;&gt;действием&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;ExpandsNT&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="ExpandsNT: ConcreteConstruct" tpgExpr="find ConcreteConstruct cc {&#xa;    A-&gt;derivedFrom.role != &quot;BEGIN&quot; and&#xa;    A-&gt;derivedFrom.role != &quot;END&quot; and&#xa;    $cc != A-&gt;belongsTo and&#xa;    $cc.ast_id == A.ast_id and&#xa;    not beginActionOf($cc)-&gt;derivedFrom.is_opaque&#xa;}" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_expands_nt">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="150" width="280" x="120" y="552" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt; с &lt;font color=&quot;#009900&quot;&gt;прозрачным&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;, который раскрывается выбранным &lt;font color=&quot;#CC0066&quot;&gt;действием&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;Expands&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="Expands: ConcreteConstruct" tpgExpr="find ConcreteConstruct cc {&#xa;    A-&gt;derivedFrom.role != &quot;BEGIN&quot; and&#xa;    A-&gt;derivedFrom.role != &quot;END&quot; and&#xa;    $cc != A-&gt;belongsTo and&#xa;    $cc.ast_id == A.ast_id and&#xa;    not beginActionOf($cc)-&gt;derivedFrom.is_opaque&#xa;}" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_expands">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="150" width="280" x="1020" y="552" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие засчитано&lt;/b&gt;&lt;br&gt;в трассу добавлены действие и &lt;font color=&quot;#009900&quot;&gt;прозрачный&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; раскрываемого &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt; правила действия&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;correct_answer&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgSkill="correct_answer" tpgRuExplanation="Действие может быть выполнено следующим и добавлено в трассу." tpgEnExplanation="The action can be performed next and is appended to the trace." tpgEffect="P = +obj : TraceAct ({&#xa;    hasAction(A);&#xa;    (A=&gt;hasValue()) ? hasValue(findUnusedValue(A));&#xa;});&#xa;Prev +=&gt; directlyBeforeOf(P);&#xa;if (A=&gt;hasValue()) P-&gt;hasValue.used = true;&#xa;if (A-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(A-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S);&#xa;Prev = P;&#xa;P = +obj : TraceAct ({ hasAction(beginActionOf(ExpandsNT)); });&#xa;Prev +=&gt; directlyBeforeOf(P);&#xa;if (beginActionOf(ExpandsNT)-&gt;derivedFrom=&gt;hasEffects())&#xa;    applyInterruptionMode(beginActionOf(ExpandsNT)-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (beginActionOf(ExpandsNT)=&gt;hasEffects())&#xa;    applyInterruptionMode(beginActionOf(ExpandsNT)-&gt;hasEffects, S)" tpgExpr="conclude: correct with ({ … });" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_r_nt_both">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;" vertex="1">
            <mxGeometry height="200" width="380" x="30" y="802" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие засчитано&lt;/b&gt;&lt;br&gt;в трассу добавлено только действие &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(перехода к нему нет — вход по &lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;&lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt; или выход при прерывании)&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt; правила действия&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;correct_answer&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgSkill="correct_answer" tpgRuExplanation="Действие может быть выполнено следующим и добавлено в трассу." tpgEnExplanation="The action can be performed next and is appended to the trace." tpgEffect="P = +obj : TraceAct ({&#xa;    hasAction(A);&#xa;    (A=&gt;hasValue()) ? hasValue(findUnusedValue(A));&#xa;});&#xa;Prev +=&gt; directlyBeforeOf(P);&#xa;if (A=&gt;hasValue()) P-&gt;hasValue.used = true;&#xa;if (A-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(A-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S)" tpgExpr="conclude: correct with ({ … });" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_r_nt_plain">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;" vertex="1">
            <mxGeometry height="200" width="380" x="490" y="802" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие засчитано&lt;/b&gt;&lt;br&gt;в трассу добавлены действие с &lt;font color=&quot;#CC0066&quot;&gt;переходом&lt;/font&gt; и &lt;font color=&quot;#009900&quot;&gt;прозрачный&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; раскрываемого &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;correct_answer&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgSkill="correct_answer" tpgRuExplanation="Действие может быть выполнено следующим и добавлено в трассу." tpgEnExplanation="The action can be performed next and is appended to the trace." tpgEffect="P = +obj : TraceAct ({&#xa;    hasAction(A);&#xa;    hasTransition(Tin);&#xa;    (A=&gt;hasValue()) ? hasValue(findUnusedValue(A));&#xa;});&#xa;Prev +=&gt; directlyBeforeOf(P);&#xa;if (A=&gt;hasValue()) P-&gt;hasValue.used = true;&#xa;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S);&#xa;if (Tin=&gt;hasEffects()) applyInterruptionMode(Tin-&gt;hasEffects, S);&#xa;Prev = P;&#xa;P = +obj : TraceAct ({ hasAction(beginActionOf(Expands)); });&#xa;Prev +=&gt; directlyBeforeOf(P);&#xa;if (beginActionOf(Expands)-&gt;derivedFrom=&gt;hasEffects())&#xa;    applyInterruptionMode(beginActionOf(Expands)-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (beginActionOf(Expands)=&gt;hasEffects())&#xa;    applyInterruptionMode(beginActionOf(Expands)-&gt;hasEffects, S)" tpgExpr="conclude: correct with ({ … });" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_r_t_both">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;" vertex="1">
            <mxGeometry height="180" width="320" x="980" y="802" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Действие засчитано&lt;/b&gt;&lt;br&gt;в трассу добавлено действие с &lt;font color=&quot;#CC0066&quot;&gt;переходом&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;по эффекту стека вызовов следующий пред-прогон войдёт в тело функции&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;correct_answer&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgSkill="correct_answer" tpgRuExplanation="Действие может быть выполнено следующим и добавлено в трассу." tpgEnExplanation="The action can be performed next and is appended to the trace." tpgEffect="P = +obj : TraceAct ({&#xa;    hasAction(A);&#xa;    hasTransition(Tin);&#xa;    (A=&gt;hasValue()) ? hasValue(findUnusedValue(A));&#xa;});&#xa;Prev +=&gt; directlyBeforeOf(P);&#xa;if (A=&gt;hasValue()) P-&gt;hasValue.used = true;&#xa;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S);&#xa;if (Tin=&gt;hasEffects()) applyInterruptionMode(Tin-&gt;hasEffects, S)" tpgExpr="conclude: correct with ({ … });" tpgSource="domain/main.tpg :: fragment commitCorrectAction()" id="cm_r_t_plain">
          <mxCell parent="g_commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=20;" vertex="1">
            <mxGeometry height="200" width="380" x="1410" y="802" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Проверка одного уровня иерархии конструктов&lt;/b&gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;checkLevel(C — конструкт этого уровня)&lt;/font&gt;" tpgKind="Fragment" tpgProcedure="fragment checkLevel(C: ConcreteConstruct)" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" tpgNote="тело цикла агрегации AND; результат итерации — correct или error с диагнозом" id="g_level">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;collapsible=0;movable=1;resizable=1;fontSize=20;" vertex="1">
            <mxGeometry height="4097" width="2460" x="120" y="4558" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; роль &lt;b&gt;выбранного&lt;/b&gt; &lt;font color=&quot;#CC0066&quot;&gt;действия&lt;/font&gt; на уровне &lt;font color=&quot;#B38F00&quot;&gt;C&lt;/font&gt; — само &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; или то, внутри чего оно раскрыто&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;если такого нет — &lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;&lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt; конструкта&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;D_a&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="Da: ConcreteAction" tpgExpr="roleActionOf(A, C)&#xa;&#xa;// lambda roleActionOf(target, C) =&#xa;//     hasContainingAction(target, C) ? containingAction(target, C) : beginActionOf(C);&#xa;// lambda containingAction(target, C) = find ConcreteAction d {&#xa;//     $d-&gt;belongsTo == C and ( $d == target or&#xa;//         forAny ConcreteConstruct cc { $cc != C and $cc.ast_id == $d.ast_id and&#xa;//             isAncestorOrSelf(target-&gt;belongsTo, $cc) } ) };&#xa;// lambda beginActionOf(C) = find ConcreteAction d {&#xa;//     $d-&gt;belongsTo == C and $d-&gt;derivedFrom.role == &quot;BEGIN&quot; };" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_da">
          <mxCell parent="g_level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=20;" vertex="1">
            <mxGeometry height="180" width="360" x="960" y="52" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; роль &lt;b&gt;предыдущего&lt;/b&gt; &lt;font color=&quot;#CC0066&quot;&gt;действия&lt;/font&gt; на уровне &lt;font color=&quot;#B38F00&quot;&gt;C&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;если &lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;&lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt; вне этого конструкта — &lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;&lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt; конструкта&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="Dp: ConcreteAction" tpgExpr="roleActionOf(P-&gt;hasAction, C)" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" id="lv_dp">
