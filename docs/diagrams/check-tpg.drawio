        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Соблюдён ли&lt;/font&gt; порядок в цепочке однотипных &lt;font color=&quot;#CC0066&quot;&gt;действий&lt;/font&gt;: &lt;font color=&quot;#B38F00&quot;&gt;D_a&lt;/font&gt; — ближайшая подходящая роль &lt;font color=&quot;#0099A8&quot;&gt;после&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;D_p&lt;/font&gt;?" tpgKind="QuestionNode" tpgExpr="not Dp=&gt;directlyBeforeOf() or&#xa;actAlreadyCurrent(Da, Dp) or&#xa;(&#xa;    Da=&gt;afterOf(Dp) and&#xa;    not forAny ConcreteAction mid {&#xa;        $mid != Da and&#xa;        $mid-&gt;derivedFrom == Da-&gt;derivedFrom and&#xa;        $mid-&gt;belongsTo == C and&#xa;        $mid=&gt;afterOf(Dp) and&#xa;        Da=&gt;afterOf($mid)&#xa;    }&#xa;) or&#xa;(&#xa;    not forAny ConcreteAction fwd {&#xa;        $fwd-&gt;derivedFrom == Da-&gt;derivedFrom and&#xa;        $fwd-&gt;belongsTo == C and&#xa;        $fwd=&gt;afterOf(Dp)&#xa;    }&#xa;)&#xa;&#xa;// lambda actAlreadyCurrent(Da, Dp) = forAny TraceAct t {&#xa;//     $t-&gt;hasAction == Da and&#xa;//     not forAny TraceAct u { $u-&gt;hasAction == Dp and $u=&gt;afterOf($t) } };" tpgSource="domain/main.tpg :: fragment checkLevel(C: ConcreteConstruct)" tpgNote="зеркало поиска ближайшего подходящего действия N в findCorrect" id="lv_q_order">
