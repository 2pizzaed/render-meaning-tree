        <object label="&lt;b&gt;В трассу добавлены оба шага&lt;/b&gt;&lt;br&gt;само &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;N&lt;/font&gt; и &lt;font color=&quot;#009900&quot;&gt;прозрачный&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt; обоих;&lt;br&gt;&lt;b&gt;поиск следующего действия продолжается&lt;/b&gt;" tpgKind="BranchResultNode" tpgResult="NULL" tpgEffect="// сначала само действие&#xa;L = +obj : TraceAct ({ hasAction(N); hasTransition(T);&#xa;    (N=&gt;hasValue()) ? hasValue(findUnusedValue(N)); });&#xa;unwindPrev +=&gt; directlyBeforeOf(L);&#xa;unwindPrev = L;&#xa;if (N=&gt;hasValue()) L-&gt;hasValue.used = true;&#xa;if (N=&gt;hasEffects()) applyInterruptionMode(N-&gt;hasEffects, S);&#xa;if (T=&gt;hasEffects()) applyInterruptionMode(T-&gt;hasEffects, S);&#xa;// затем BEGIN нового конструкта&#xa;L = +obj : TraceAct ({ hasAction(A); });&#xa;unwindPrev +=&gt; directlyBeforeOf(L);&#xa;if (A-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(A-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (A=&gt;hasEffects()) applyInterruptionMode(A-&gt;hasEffects, S);" tpgExpr="conclude : null with ({ … });" tpgSource="domain/findCorrect.tpg :: fragment unwindNewConstruct(C: ConcreteConstruct)" id="u_res_both">
          <mxCell parent="g_unw" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6E6E6;strokeColor=#666666;fontSize=16;dashed=1;dashPattern=6 4;" vertex="1">
