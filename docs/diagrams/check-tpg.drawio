        <object label="&lt;b&gt;Свойства объектов&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;роль&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;правило действия&lt;/font&gt;), string: BEGIN, END, cond, body, …&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;вид&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;правило действия&lt;/font&gt;), string: condition, block, loop, call, …&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;непрозрачность&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;правило действия&lt;/font&gt;), bool: студент обязан выбрать действие явно&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;имя&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;правило конструкта&lt;/font&gt;), string: global_statements_structure,&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/font&gt;func_def_structure, func_call_structure, …&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;значение условия&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;ограничение&lt;/font&gt;), bool или не задано&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;ограничение&lt;/font&gt;), &lt;font color=&quot;#CC0066&quot;&gt;тип прерывания&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;начало прерывания&lt;/font&gt; / &lt;font color=&quot;#009900&quot;&gt;снятие прерывания&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;эффект&lt;/font&gt;), &lt;font color=&quot;#CC0066&quot;&gt;тип прерывания&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;действие со стеком вызовов&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;эффект&lt;/font&gt;), &lt;font color=&quot;#CC0066&quot;&gt;действие со стеком вызовов&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;состояние трассировки&lt;/font&gt;), &lt;font color=&quot;#CC0066&quot;&gt;тип прерывания&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;логическое значение&lt;/font&gt;, &lt;font color=&quot;#009900&quot;&gt;использовано&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;значение времени выполнения&lt;/font&gt;), bool&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;id узла AST&lt;/font&gt;, &lt;font color=&quot;#009900&quot;&gt;тип узла AST&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;сущность AST&lt;/font&gt;), int, string&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;режим прохода непрозрачных действий&lt;/font&gt; (&lt;font color=&quot;#CC0066&quot;&gt;конфигурация трассировки&lt;/font&gt;), bool" tpgKind="Dictionary" tpgDict="Object properties" tpgHint="ActionSpec: role/generalization/kind: string, is_opaque: bool; ConstructSpec: name/kind: string; Constraint: condition_value: OptionalBool, interruption_mode: InterruptionType; Effect: interruption_start/interruption_stop: InterruptionType, call_stack: CallStackAction; TraceState: interruption_mode; SemanticValue: bool_value/used: bool; ASTEntity: ast_id: int, ast_type: string; TraceConfigSpec: stop_on_opaque: bool; класс-свойств (class prop) в этом домене не объявлено" id="n_props">
