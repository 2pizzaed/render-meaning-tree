        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; ещё не раскрытый &lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt; с &lt;font color=&quot;#009900&quot;&gt;непрозрачным&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt;, к узлу AST которого &lt;font color=&quot;#0099A8&quot;&gt;относится&lt;/font&gt; текущее &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;C&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="C: ConcreteConstruct" tpgExpr="find ConcreteConstruct c {&#xa;    forAny ConcreteAction a {$a=&gt;belongsTo($c) and $a-&gt;derivedFrom.role == &quot;BEGIN&quot; and $a-&gt;derivedFrom.is_opaque} and&#xa;    L-&gt;hasAction-&gt;derivedFrom.role != &quot;BEGIN&quot; and&#xa;    L-&gt;hasAction-&gt;derivedFrom.role != &quot;END&quot; and&#xa;    $c.ast_id == L-&gt;hasAction.ast_id and&#xa;    not forAny TraceAct t {&#xa;        $t-&gt;hasAction-&gt;belongsTo == $c&#xa;        and $t-&gt;hasAction-&gt;derivedFrom.role == &quot;BEGIN&quot;&#xa;        and not forAny TraceAct e {&#xa;            $e-&gt;hasAction-&gt;belongsTo == $c&#xa;            and $e-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot;&#xa;            and $e=&gt;afterOf($t)&#xa;        }&#xa;    }&#xa;}" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_find_C">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
