        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Встречалось ли&lt;/font&gt; это &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; в трассе раньше?" tpgKind="QuestionNode" tpgExpr="forAny TraceAct t {$t-&gt;hasAction == N}" tpgSource="domain/findCorrect.tpg :: fragment checkRepeatedAction(N: ConcreteAction)" id="a_q_rep">
          <mxCell parent="g_chk" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="120" width="400" x="30" y="177" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; следующее ещё &lt;font color=&quot;#009900&quot;&gt;не использованное&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; той же цепочки &lt;font color=&quot;#0099A8&quot;&gt;после&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;N&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;N1&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="N1: ConcreteAction" tpgExpr="find ConcreteAction n {$n=&gt;afterOf(N)&#xa;    and not (forAny TraceAct t {$t-&gt;hasAction == $n})&#xa;    and $n=&gt;isCloserToThan(&#xa;        N,&#xa;        findExtreme lastN [not $lastN=&gt;beforeOf($c)] among ConcreteAction c {$c=&gt;afterOf(N)}&#xa;    )&#xa;}" tpgSource="domain/findCorrect.tpg :: fragment checkRepeatedAction(N: ConcreteAction)" id="a_find_n1">
          <mxCell parent="g_chk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="360" x="50" y="372" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Классифицировать&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;N1&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;фрагмент «Классификация» →&lt;/font&gt;" tpgKind="ProcedureCallNode" tpgProcedure="fragment classifyAction(N: ConcreteAction)" tpgExpr="`fragment`:classifyAction(N1);" tpgSource="domain/findCorrect.tpg :: fragment checkRepeatedAction(N: ConcreteAction)" id="a_call_N1">
          <mxCell parent="g_chk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="360" x="50" y="582" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Классифицировать&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;N&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;фрагмент «Классификация» →&lt;/font&gt;" tpgKind="ProcedureCallNode" tpgProcedure="fragment classifyAction(N: ConcreteAction)" tpgExpr="`fragment`:classifyAction(N);" tpgAdaptation="в модели это два отдельных вызова classifyAction(N) — из ветви «не встречалось» и из ветви «продолжения в цепочке нет»; на схеме они сведены в один узел, так как это один и тот же шаг" tpgSource="domain/findCorrect.tpg :: fragment checkRepeatedAction(N: ConcreteAction)" id="a_call_N">
