// ============================================================================
//  main.tpg — Граф проверок (проверка выбора студента при трассировке).
//
//
//  СТАТУС: реализован полный алгоритм docs/check_graph_idea.md:
//    шаг 1     — предпрогонка findCorrect по прозрачным действиям (subcall_mut);
//    шаг 2     — everything_evaluated / action_cannot_repeat;
//    шаг 3.1   — действие внутри функции, в которую не входили / из которой вышли;
//    шаг 3.1а  — A раскрывает preorder-конструкт, который ещё выполняется;
//    шаг 3.2   — активное прерывание требует выхода из текущего конструкта;
//    шаги 4-5  — цикл агрегации AND по конструктам от общего (LCA) до конструкта A,
//                на каждом уровне checkLevel классифицирует переход D_p -> D_a
//                по критериям (вход в конструкт, пропуск непрозрачного действия,
//                наличие перехода, порядок в цепочке, прерывание, значение условия,
//                завершённость раскрытого из D_p конструкта);
//    шаг 6     — фиксация A актом трассы (+переход, +значение, +эффекты,
//                +прозрачный BEGIN раскрываемого конструкта, зеркально
//                unfoldNewConstruct из findCorrect; у BEGIN-акта заполняется
//                unfoldedFrom — действие, из которого конструкт раскрыт).
//
//  preorder-конструкты (ConstructSpec.preorder, см. docs/domain.md): раскрытие
//  предшествует породившему действию, и это действие попадает в трассу после END
//  конструкта. Поэтому здесь: критерий пропуска промежуточного действия ослаблен
//  для отложенного D_a (isDeferredUnfoldAction), выбор самого отложенного действия
//  после END конструкта считается корректным шагом (isPendingUnfoldAction),
//  завершённость раскрытого конструкта проверяется зеркально
//  (unfoldedConstructFinished), а BEGIN такого конструкта при фиксации не
//  достраивается — он уже добавлен при раскрытии.
//
//  Связь «действие -> раскрываемый им конструкт» повсюду по равенству ast_id
//  (как в findCorrect и src/model/situation.py: Action.expands_to), БЕЗ hasParent:
//  так работает и граница вызова функции (действие func несёт ast_id узла
//  определения функции). BEGIN/END конкретного конструкта имеют ast_id самого
//  конструкта, поэтому в поисках раскрытия конструкт C исключается ($cc != C).
//
//  Известные ограничения (задокументированные, для доводки тестами):
//    - выход из функции: роль P на уровнях ВНЕ тела функции ищется по статической
//      иерархии (через конструкт определения функции); ослабляющий критерий
//      «D_a уже есть в трассе позже последнего акта D_p» покрывает типовые случаи;
//    - семантические значения расходуются по всей трассе и не сбрасываются при повторном
//      входе в конструкт: цепочка значений действия должна покрывать все его выполнения
//      в задаче (все вызовы функции, все итерации внешних циклов);
//    - предпрогонка findCorrect может сама добавить непрозрачный BEGIN конструкта,
//      на который указывает последнее действие (поведение findCorrect);
//    - для отложенного действия preorder-конструкта переход в акт не переносится
//      (в findCorrect он берётся из hasTransition BEGIN-акта): критерии уровня
//      его не требуют, а эффектов на таких переходах в правилах сейчас нет.
//
//  Термины (из docs/check_graph_idea.md):
//    Ошибка студента       -> conclude: error [ skill = ...; RU.explanation = ...; EN.explanation = ... ]
//    Внутреннее исключение -> conclude: error [ exception = true; exceptionName = ... ]
//
//  Объяснения — шаблоны: ${X} подставляет localizedName переменной X из снимка
//  переменных conclude-узла, ${X}[case='р'] — то же в нужном падеже (только RU),
//  ${X.prop} — значение свойства (для перечисления — его localizedName из
//  domain.loqi; значение берётся из ситуации ПОСЛЕ прогона).
//
//  Объяснение называет ПРИЧИНУ, по которой A сейчас не выполняется, а не
//  следующий верный шаг: в текстах нет «сначала выполняется X», «нужно выйти из
//  Y», «выполнение ушло в Z». Строится как в ControlFlow CompPrehension: правило
//  конструкции языка, затем его применение к ситуации, связанное союзами («так
//  как», «потому что», «поэтому»), без двоеточий. Правило выводится из данных:
//  ограничения перехода (значение условия), вида прерывания (localizedName
//  InterruptionType), структуры конструкции. Конструкции и действия называются
//  только своим localizedName (${C}, ${ValueExited}, ...): слов «цикл»,
//  «ветвление», «функция» в шаблонах нет — вид конструкции текст не угадывает.
//  ConstructSpec.kind допустим лишь как условие выбора правила, которое для
//  других видов неверно. Студенту понятны только термины языка и алгоритмов:
//  служебных слов модели («трасса», «переход», «акт») в текстах нет.
//  Объяснение не показывает неполноту проверки: если граф вывел причину по
//  состоянию трассы (autoPassedRefinement), текст утверждает её как факт.
//  Ссылки — на действия и конструкты (A, C, Da, Dp, Dcc и переменные, найденные
//  перед conclude только для текста: Blocking, Decider, Interrupter, ...), а не на
//  акты трассы: акты, созданные во время прогона, не имеют localizedName. Объект,
//  гарантированный проверкой выше, при отсутствии даёт внутреннее исключение, а не
//  пустой для студента текст. Имя пишется со строчной буквы, поэтому фраза с него
//  не начинается; согласование по роду обходится формулировкой («выполнение X»,
//  настоящее время, «это действие»). Имена условий начинаются со слова «условие»,
//  поэтому «${Dp} ложно» согласовано.
// ============================================================================


// ---------------------------------------------------------------------------
//  Переиспользуемые лямбды из findCorrect (у каждого .tpg — своя копия,
//  treeDeclHelpers привязаны к одному объявлению tpg).
// ---------------------------------------------------------------------------

// Применить эффект перехода/действия к глобальному состоянию трассировки.
lambda applyInterruptionMode(E: Effect, S: TraceState) =
    E.interruption_start != InterruptionType:none ?
            S.interruption_mode = E.interruption_start                // начинается новое прерывание
        : (
            E.interruption_stop != InterruptionType:none and (
                E.interruption_stop == InterruptionType:any or
                S.interruption_mode == E.interruption_stop
            )
                ? S.interruption_mode = InterruptionType:none         // остановить текущее прерывание
                : (S.interruption_mode = S.interruption_mode)         // ничего не делать (self-assign)
    );

// Ближайшее ещё не использованное семантическое значение действия A.
lambda findUnusedValue(A: ConcreteAction) = findExtreme unused [
    $unused == A->hasValue or $unused=>isCloserToThan(A->hasValue, $v)
] among SemanticValue v {
    A=>hasValue() and ($v=>afterOf(A->hasValue) or $v == A->hasValue) and not $v.used
};

// Fallback-цель перехода: первый реально присутствующий в C элемент цепочки
// to_when_absent, либо основная цель to_, если fallback не задан.
lambda toWhenAbsent(T: TransitionSpec, C: ConcreteConstruct) = if (T=>to_when_absent()) (findExtreme present [
    $present=>isCloserToThan(T->to_when_absent, $ap) or $present == T->to_when_absent
] among ActionSpecChainPlaceholder ap {
    ($ap=>afterOf(T->to_when_absent) or $ap == T->to_when_absent) and
    forAny ConcreteAction aa {C=>hasActions($aa) and $aa=>derivedFrom($ap->contains)}
})->contains else T->to_;


// ---------------------------------------------------------------------------
//  Помощники графа проверок (декомпозиция из docs/check_graph_idea.md).
// ---------------------------------------------------------------------------

// Является ли `node` тем же конструктом, что `ancestor`, или его потомком.
lambda isAncestorOrSelf(node: ConcreteConstruct, ancestor: ConcreteConstruct) =
    node == ancestor or node=>hasAncestor(ancestor);

// 1. Наиболее вложенный общий конструкт (LCA) двух действий.
// Общий предок C такой, что нет более глубокого общего предка `deeper`,
// который сам является потомком C.
lambda commonConstruct(actionA: ConcreteAction, actionP: ConcreteAction) = find ConcreteConstruct c {
    isAncestorOrSelf(actionA->belongsTo, $c) and
    isAncestorOrSelf(actionP->belongsTo, $c) and
    not forAny ConcreteConstruct deeper {
        $deeper != $c and
        isAncestorOrSelf(actionA->belongsTo, $deeper) and
        isAncestorOrSelf(actionP->belongsTo, $deeper) and
        $deeper=>hasAncestor($c)
    }
};

// Действие с ролью BEGIN в конструкте C (правило).
lambda beginActionOf(C: ConcreteConstruct) = find ConcreteAction d {
    $d->belongsTo == C and $d->derivedFrom.role == "BEGIN"
};

// 2. Действие уровня C, «внутри» которого находится `target» —
// либо это само `target`, либо действие C, чей раскрываемый конструкт
// (связь по ast_id, кроме самого C — BEGIN/END носят ast_id конструкта)
// является предком (или самим) конструкта `target`. Связь через вызов (тело функции
// лексически не вложено в C) учитывается, только пока этот вызов выполняется:
// при рекурсии вызов лежит в теле той же функции, и статическая связь зациклилась бы.
lambda containingAction(target: ConcreteAction, C: ConcreteConstruct) = find ConcreteAction d {
    $d->belongsTo == C and (
        $d == target or
        target->belongsTo != C and forAny ConcreteConstruct cc {
            $cc != C and
            $cc.ast_id == $d.ast_id and
            isAncestorOrSelf(target->belongsTo, $cc) and
            ($cc=>hasAncestor(C) or callActive($d))
        }
    )
};

// Существует ли такое действие уровня C (для безопасного fallback на BEGIN).
lambda hasContainingAction(target: ConcreteAction, C: ConcreteConstruct) = forAny ConcreteAction d {
    $d->belongsTo == C and (
        $d == target or
        target->belongsTo != C and forAny ConcreteConstruct cc {
            $cc != C and
            $cc.ast_id == $d.ast_id and
            isAncestorOrSelf(target->belongsTo, $cc) and
            ($cc=>hasAncestor(C) or callActive($d))
        }
    )
};

// Если действие уровня C не находится (target вне C), берём BEGIN конструкта C.
lambda roleActionOf(target: ConcreteAction, C: ConcreteConstruct) =
    hasContainingAction(target, C) ? containingAction(target, C) : beginActionOf(C);

// Последний акт трассы, находящийся внутри конструкта C (на любом уровне вложенности).
// Условие повторяет hasContainingAction с собственными именами переменных:
// лямбды подставляются inline, и вложенный вызов затенил бы переменную d.
lambda lastActInside(C: ConcreteConstruct) = findExtreme latest [
    not $latest=>beforeOf($t)
] among TraceAct t {
    $t->inFrame == frameOf(C) and
    forAny ConcreteAction inner {
        $inner->belongsTo == C and (
            $inner == $t->hasAction or
            $t->hasAction->belongsTo != C and forAny ConcreteConstruct innerCc {
                $innerCc != C and
                $innerCc.ast_id == $inner.ast_id and
                isAncestorOrSelf($t->hasAction->belongsTo, $innerCc) and
                ($innerCc=>hasAncestor(C) or callActive($inner))
            }
        )
    }
};

// Роль уровня C для последнего корректного действия с учётом стека вызовов.
// Если действие статически вне C, но C ещё открыт, выполнение находится в теле
// функции, вызванной из C: роль — действие C, из которого раскрыт этот вызов
// (по последнему акту трассы внутри C), а не BEGIN конструкта C.
lambda currentRoleActionOf(target: ConcreteAction, C: ConcreteConstruct) =
    hasContainingAction(target, C) ? containingAction(target, C) : (
        isConstructOpen(C) ? containingAction(lastActInside(C)->hasAction, C) : beginActionOf(C)
    );

// --- кадры вызова (TraceAct.inFrame, см. findCorrect.tpg) -----------------------
// Акты разных активаций одной функции различаются кадром, поэтому BEGIN/END,
// последние акты и «содержащие» действия ищутся в кадре текущей активации.

// Кадр вызова X закрыт: в нём уже есть END тела функции (END несёт ast_id определения
// функции, как и действие func вызова X); для корневого кадра - END программы.
lambda frameClosed(X: TraceAct) = forAny TraceAct fe {
    $fe->inFrame == X and
    $fe->hasAction->derivedFrom.role == "END" and
    $fe->hasAction.ast_id == X->hasAction.ast_id
};

// Кадр X обслуживает конструкт C: в кадре есть акты, он ещё не закрыт, и его функция
// (действие func кадра несёт ast_id её определения; у корневого кадра - ast_id программы)
// - ближайшая объемлющая C функция (или программа, если C вне функций).
lambda frameServes(X: TraceAct, C: ConcreteConstruct) =
    forAny TraceAct fxIn { $fxIn->inFrame == X } and
    not frameClosed(X) and
    forAny ConcreteConstruct fxFunc {
        $fxFunc.ast_id == X->hasAction.ast_id and
        isAncestorOrSelf(C, $fxFunc) and
        not forAny ConcreteConstruct fxInner {
            $fxInner != $fxFunc and
            $fxInner->derivedFrom.name == "func_def_structure" and
            isAncestorOrSelf(C, $fxInner) and
            $fxInner=>hasAncestor($fxFunc)
        }
    };

// Кадр текущей активации конструкта C: самый внутренний обслуживающий его кадр
// (при рекурсии живы несколько активаций одной функции - текущая самая внутренняя).
// Нет, если функция C сейчас не выполняется.
lambda frameOf(C: ConcreteConstruct) = findExtreme innermost [
    not $innermost=>beforeOf($fx)
] among TraceAct fx { frameServes($fx, C) };

// Есть ли у конструкта C выполняющаяся активация.
lambda hasLiveFrame(C: ConcreteConstruct) = forAny TraceAct fy { frameServes($fy, C) };

// Акт t относится к текущей активации конструкта C. Если функция C уже не
// выполняется (например, только что вышли из неё по return), подходят акты любого кадра.
lambda inCurrentActivation(t: TraceAct, C: ConcreteConstruct) =
    t->inFrame == frameOf(C) or not hasLiveFrame(C);

// Вызов через действие D сейчас выполняется: есть акт D, открывший кадр
// (в кадре есть акты), и этот кадр ещё не закрыт.
lambda callActive(D: ConcreteAction) = forAny TraceAct cx {
    $cx->hasAction == D and
    $cx->inFrame == frameOf(D->belongsTo) and
    forAny TraceAct cxIn { $cxIn->inFrame == $cx and $cxIn != $cx } and
    not forAny TraceAct cxEnd {
        $cxEnd->inFrame == $cx and
        $cxEnd->hasAction->derivedFrom.role == "END" and
        $cxEnd->hasAction.ast_id == $cx->hasAction.ast_id
    }
};

// Последний акт трассы для конкретного действия D в текущей активации его
// конструкта (при повторных входах интересен именно последний акт, при рекурсии -
// акт самой внутренней выполняющейся активации функции).
lambda lastActOf(D: ConcreteAction) = findExtreme latest [
    not $latest=>beforeOf($t)
] among TraceAct t {
    $t->hasAction == D and
    $t->inFrame == frameOf(D->belongsTo)
};

// Открыт ли конструкт C в трассе: в кадре текущей активации есть BEGIN-акт без
// последующего END-акта (END вложенной активации той же функции его не закрывает).
lambda isConstructOpen(C: ConcreteConstruct) = forAny TraceAct b {
    $b->inFrame == frameOf(C) and
    $b->hasAction->belongsTo == C and $b->hasAction->derivedFrom.role == "BEGIN" and
    not forAny TraceAct e {
        $e->inFrame == $b->inFrame and
        $e->hasAction->belongsTo == C and $e->hasAction->derivedFrom.role == "END" and
        $e=>afterOf($b)
    }
};

// 3+4. Закрыт ли конструкт C «в рамках текущего контекста», заданного актом E
// (акт действия, из которого C раскрывается): после E есть END-акт C, за которым
// уже не следует новый BEGIN-акт C. Поскольку проверка всегда ведётся о конце
// трассы, правая граница области (END охватывающего конструкта) не нужна —
// текущая активация тянется до конца трассы. Повторные входы (циклы, повторные
// вызовы функций) отсекаются требованием «после E» и «нет BEGIN после END».
// Акты C ищутся в кадре E, а для тела функции - в кадре, открытом E (действие func).
lambda isClosedAfter(C: ConcreteConstruct, E: TraceAct) = forAny TraceAct e {
    ($e->inFrame == E->inFrame or $e->inFrame == E) and
    $e->hasAction->belongsTo == C and $e->hasAction->derivedFrom.role == "END" and
    $e=>afterOf(E) and
    not forAny TraceAct b {
        $b->inFrame == $e->inFrame and
        $b->hasAction->belongsTo == C and $b->hasAction->derivedFrom.role == "BEGIN" and
        $b=>afterOf($e)
    }
};

// Акт D_a уже есть в трассе в текущем контексте: есть акт D_a, после которого
// не было нового акта D_p (т.е. D_a исполнялось после последнего исполнения D_p).
// Ослабляет критерии порядка/пропуска для действий, уже пройденных на этом
// уровне (например, оператор с вызовом функции при проверке выхода из вызова).
lambda actAlreadyCurrent(Da: ConcreteAction, Dp: ConcreteAction) = forAny TraceAct t {
    $t->hasAction == Da and
    $t->inFrame == frameOf(Da->belongsTo) and
    not forAny TraceAct u {
        $u->inFrame == $t->inFrame and
        $u->hasAction == Dp and
        $u=>afterOf($t)
    }
};

// Переход t уровня C ведёт из fromA в toA. Fallback to_when_absent учитывается
// только когда основная цель to_ отсутствует среди конкретных действий C
// (зеркало поиска N / N_absent в findCorrect).
lambda transitionLeads(t: TransitionSpec, fromA: ConcreteAction, toA: ConcreteAction, C: ConcreteConstruct) =
    t->belongsTo == C->derivedFrom and
    t->from_ == fromA->derivedFrom and
    (
        t->to_ == toA->derivedFrom or (
            (not forAny ConcreteAction primary {
                $primary->belongsTo == C and $primary->derivedFrom == t->to_
            }) and
            toWhenAbsent(t, C) == toA->derivedFrom
        )
    );

// Ограничение перехода по режиму прерывания выполняется.
lambda interruptionOk(t: TransitionSpec, S: TraceState) =
    not t=>hasConstraints() or
    t->hasConstraints.interruption_mode == S.interruption_mode or
    t->hasConstraints.interruption_mode == InterruptionType:any;

// Ограничение перехода по значению условия выполняется
// (зеркало фазового поиска перехода в findCorrect).
lambda conditionOk(t: TransitionSpec, fromA: ConcreteAction) =
    not t=>hasConstraints() or
    not fromA=>hasValue() or
    findUnusedValue(fromA).bool_value == t->hasConstraints.condition_value;

// Роли fromA и toA — альтернативные ветви конструкта C: из каждой ведёт переход
// прямо в END конструкта (ветви ветвления), поэтому одна исключает другую.
lambda branchAlternatives(fromA: ConcreteAction, toA: ConcreteAction, C: ConcreteConstruct) =
    forAny TransitionSpec t1 {
        $t1->belongsTo == C->derivedFrom and
        $t1->from_ == fromA->derivedFrom and
        $t1->to_.role == "END"
    } and
    forAny TransitionSpec t2 {
        $t2->belongsTo == C->derivedFrom and
        $t2->from_ == toA->derivedFrom and
        $t2->to_.role == "END"
    };

// Непрозрачное действие D уровня C всё равно проходится автоматически, если раскрывает
// (не preorder) конструкт с прозрачным BEGIN: findCorrect добавляет D вместе с этим BEGIN
// (classifyAction -> unfoldNewConstruct), поэтому D — не шаг студента.
lambda autoPassedByUnfold(D: ConcreteAction, C: ConcreteConstruct) = forAny ConcreteConstruct cc {
    $cc != C and
    $cc.ast_id == D.ast_id and
    not $cc->derivedFrom.preorder and
    not beginActionOf($cc)->derivedFrom.is_opaque
};

// --- preorder-конструкты (раскрытие предшествует породившему действию) ---------

// Действие, из которого раскрывается конструкт C (связь по ast_id, как в containingAction).
// Одно и то же ast_id могут нести действия нескольких конструктов (вложенные inline-конструкты
// print(f(x)) оба ссылаются на вызов), поэтому берём действие открытого конструкта —
// того, из которого findCorrect раскрывает C в текущем контексте.
lambda unfoldingActionOf(C: ConcreteConstruct) = find ConcreteAction x {
    $x->belongsTo != C and
    $x.ast_id == C.ast_id and
    $x->derivedFrom.role != "BEGIN" and
    $x->derivedFrom.role != "END" and
    isConstructOpen($x->belongsTo)
};

lambda hasUnfoldingAction(C: ConcreteConstruct) = forAny ConcreteAction x {
    $x->belongsTo != C and
    $x.ast_id == C.ast_id and
    $x->derivedFrom.role != "BEGIN" and
    $x->derivedFrom.role != "END" and
    isConstructOpen($x->belongsTo)
};

// D - действие уровня C, раскрывающее preorder-конструкт, внутри которого находится target.
// Такое действие попадает в трассу ПОСЛЕ END своего конструкта, поэтому его отсутствие
// в трассе перед target - не пропуск, а отложенное выполнение.
lambda isDeferredUnfoldAction(D: ConcreteAction, target: ConcreteAction) = forAny ConcreteConstruct cc {
    $cc != D->belongsTo and
    $cc.ast_id == D.ast_id and
    $cc->derivedFrom.preorder and
    isAncestorOrSelf(target->belongsTo, $cc)
};

// target - отложенное действие preorder-конструкта, END которого уже последний акт трассы:
// раскрытый конструкт завершён, и теперь это действие должно быть добавлено в трассу.
lambda isPendingUnfoldAction(target: ConcreteAction) = forAny TraceAct e {
    $e->hasAction->derivedFrom.role == "END" and
    $e->hasAction->belongsTo->derivedFrom.preorder and
    $e->hasAction.ast_id == target.ast_id and
    not forAny TraceAct later { $later=>afterOf($e) } and
    forAny TraceAct b {
        $b->hasAction->belongsTo == $e->hasAction->belongsTo and
        $b->hasAction->derivedFrom.role == "BEGIN" and
        $b=>beforeOf($e) and
        $b->unfoldedFrom == target
    }
};

// Зеркало isClosedAfter для preorder-конструктов: их END лежит ДО акта E
// (акт породившего действия добавляется уже после завершения конструкта).
lambda isClosedBefore(C: ConcreteConstruct, E: TraceAct) = forAny TraceAct e {
    ($e->inFrame == E->inFrame or $e->inFrame == E) and
    $e->hasAction->belongsTo == C and $e->hasAction->derivedFrom.role == "END" and
    $e=>beforeOf(E) and
    not forAny TraceAct b {
        $b->inFrame == $e->inFrame and
        $b->hasAction->belongsTo == C and $b->hasAction->derivedFrom.role == "BEGIN" and
        $b=>afterOf($e) and $b=>beforeOf(E)
    }
};

// Действие D ещё ждёт своей очереди: раскрытый из него preorder-конструкт (вызов)
// сейчас выполняется, а акт самого D появится только после END этого конструкта.
lambda awaitsUnfoldedConstruct(D: ConcreteAction, C: ConcreteConstruct) = forAny ConcreteConstruct cc {
    $cc != C and
    $cc.ast_id == D.ast_id and
    $cc->derivedFrom.preorder and
    isConstructOpen($cc)
};

// Раскрытый из акта E конструкт C завершён (с учётом порядка раскрытия).
lambda unfoldedConstructFinished(C: ConcreteConstruct, E: TraceAct) =
    C->derivedFrom.preorder ? isClosedBefore(C, E) : isClosedAfter(C, E);

// --- объекты для объяснений ---------------------------------------------------
// Используются только для подстановки в тексты conclude-узлов. Кандидаты всегда
// упорядочены (вложенность конструктов, порядок в трассе или в цепочке действий),
// чтобы find/findExtreme не давали неоднозначности.

// Действие D начинает прерывание (break, continue, return): эффект interruption_start
// задаётся у правила действия или у самого действия (как в applyInterruptionMode).
lambda startsInterruption(D: ConcreteAction) =
    (D->derivedFrom=>hasEffects() and D->derivedFrom->hasEffects.interruption_start != InterruptionType:none) or
    (D=>hasEffects() and D->hasEffects.interruption_start != InterruptionType:none);

// Действие последнего акта трассы, начавшего прерывание.
lambda lastInterrupterAction() = find ConcreteAction ia {
    startsInterruption($ia) and
    forAny TraceAct t {
        $t->hasAction == $ia and
        not forAny TraceAct later {
            $later=>afterOf($t) and startsInterruption($later->hasAction)
        }
    }
};

// Акт t — вход в ДРУГУЮ ветвь конструкта действия A: конструкт раскрыт из действия
// того же уровня, отличного от A. Вход в тело вызванной функции этому не
// соответствует (её конструкт не раскрывается действием уровня A).
lambda entersSiblingBranch(t: TraceAct, A: ConcreteAction) =
    t->hasAction->derivedFrom.role == "BEGIN" and
    t->hasAction.ast_id != A.ast_id and
    t->hasAction->belongsTo=>hasParent(A->belongsTo) and
    forAny ConcreteAction sibling {
        $sibling->belongsTo == A->belongsTo and
        $sibling != A and
        $sibling.ast_id == t->hasAction.ast_id
    };


// ---------------------------------------------------------------------------
//  Фрагменты.
// ---------------------------------------------------------------------------

// Шаг 6: зафиксировать выбранное действие A как корректное — добавить акт трассы,
// присоединить его к последнему акту, израсходовать значение, применить эффекты
// действия и перехода (если переход в A существует — он прикладывается к акту:
// по hasTransition с эффектом call_stack следующая предпрогонка входит в функцию).
// Если A раскрывает конструкт с прозрачным BEGIN, BEGIN достраивается сразу
// (зеркало unfoldNewConstruct из findCorrect). Завершает граф успехом.
fragment commitCorrectAction() {
    var Prev: TraceAct = findExtreme lastAct [not $lastAct=>beforeOf($a)] among TraceAct a {true};
    // роль P на уровне конструкта выбранного действия — источник перехода в A
    var DpFin: ConcreteAction = roleActionOf(P->hasAction, A->belongsTo);
    var Tin: TransitionSpec = find TransitionSpec t {
        transitionLeads($t, DpFin, A, A->belongsTo) and
        interruptionOk($t, S) and
        conditionOk($t, DpFin)
    } out true else {
        // === Перехода нет (вход по BEGIN или вынужденный выход при прерывании) —
        // эффекты правила действия применяем явно, как в findLastTracedAction.
        var ExpandsNT: ConcreteConstruct = find ConcreteConstruct cc {
            A->derivedFrom.role != "BEGIN" and
            A->derivedFrom.role != "END" and
            $cc != A->belongsTo and
            $cc.ast_id == A.ast_id and
            not $cc->derivedFrom.preorder and // см. Expands ниже
            not beginActionOf($cc)->derivedFrom.is_opaque
        } out false else {
            // A раскрывает конструкт с прозрачным BEGIN — фиксируем оба акта сразу
            conclude: correct with ({
                P = +obj : TraceAct (
                    {
                        hasAction(A);
                        (A=>hasValue()) ? hasValue(findUnusedValue(A));
                    }
                );
                Prev +=> directlyBeforeOf(P);
                if (A=>hasValue()) P->hasValue.used = true;
                if (A->derivedFrom=>hasEffects()) applyInterruptionMode(A->derivedFrom->hasEffects, S);
                if (A=>hasEffects()) applyInterruptionMode(A->hasEffects, S);
                Prev = P;
                P = +obj : TraceAct (
                    {
                        hasAction(beginActionOf(ExpandsNT));
                    }
                );
                Prev +=> directlyBeforeOf(P);
                if (beginActionOf(ExpandsNT)->derivedFrom=>hasEffects()) applyInterruptionMode(beginActionOf(ExpandsNT)->derivedFrom->hasEffects, S);
                if (beginActionOf(ExpandsNT)=>hasEffects()) applyInterruptionMode(beginActionOf(ExpandsNT)->hasEffects, S)
            }) [
                skill = "correct_answer";
                RU.explanation = "Верно, следующим выполняется ${A}." ;
                EN.explanation = "Correct, the ${A} is executed next." ;
            ];
        };
        conclude: correct with ({
            P = +obj : TraceAct (
                {
                    hasAction(A);
                    // BEGIN раскрытого конструкта помнит породившее его действие:
                    // для preorder-конструкта оно добавляется в трассу после END
                    (A->derivedFrom.role == "BEGIN" and hasUnfoldingAction(A->belongsTo)) ? unfoldedFrom(unfoldingActionOf(A->belongsTo));
                    (A=>hasValue()) ? hasValue(findUnusedValue(A));
                }
            );
            Prev +=> directlyBeforeOf(P);
            if (A=>hasValue()) P->hasValue.used = true;
            if (A->derivedFrom=>hasEffects()) applyInterruptionMode(A->derivedFrom->hasEffects, S);
            if (A=>hasEffects()) applyInterruptionMode(A->hasEffects, S)
        }) [
            skill = "correct_answer";
            RU.explanation = "Верно, следующим выполняется ${A}." ;
            EN.explanation = "Correct, the ${A} is executed next." ;
        ];
    };
    // === Переход найден: он прикладывается к акту (по hasTransition с эффектом
    // call_stack следующая предпрогонка findCorrect входит в тело функции).
    var Expands: ConcreteConstruct = find ConcreteConstruct cc {
        A->derivedFrom.role != "BEGIN" and
        A->derivedFrom.role != "END" and
        $cc != A->belongsTo and
        $cc.ast_id == A.ast_id and
        // preorder-конструкт раскрыт и закрыт ДО этого действия (его BEGIN добавлен
        // при раскрытии), поэтому здесь достраивать нечего
        not $cc->derivedFrom.preorder and
        not beginActionOf($cc)->derivedFrom.is_opaque
    } out false else {
        // A раскрывает конструкт с прозрачным BEGIN — фиксируем оба акта сразу
        // (зеркало unfoldNewConstruct из findCorrect); непрозрачный BEGIN добавит
        // следующая предпрогонка findCorrect либо выберет студент.
        conclude: correct with ({
            P = +obj : TraceAct (
                {
                    hasAction(A);
                    hasTransition(Tin);
                    (A=>hasValue()) ? hasValue(findUnusedValue(A));
                }
            );
            Prev +=> directlyBeforeOf(P);
            if (A=>hasValue()) P->hasValue.used = true;
            if (A=>hasEffects()) applyInterruptionMode(A->hasEffects, S);
            if (Tin=>hasEffects()) applyInterruptionMode(Tin->hasEffects, S);
            Prev = P;
            P = +obj : TraceAct (
                {
                    hasAction(beginActionOf(Expands));
                }
            );
            Prev +=> directlyBeforeOf(P);
            if (beginActionOf(Expands)->derivedFrom=>hasEffects()) applyInterruptionMode(beginActionOf(Expands)->derivedFrom->hasEffects, S);
            if (beginActionOf(Expands)=>hasEffects()) applyInterruptionMode(beginActionOf(Expands)->hasEffects, S)
        }) [
            skill = "correct_answer";
            RU.explanation = "Верно, следующим выполняется ${A}." ;
            EN.explanation = "Correct, the ${A} is executed next." ;
        ];
    };
    conclude: correct with ({
        P = +obj : TraceAct (
            {
                hasAction(A);
                hasTransition(Tin);
                (A->derivedFrom.role == "BEGIN" and hasUnfoldingAction(A->belongsTo)) ? unfoldedFrom(unfoldingActionOf(A->belongsTo));
                (A=>hasValue()) ? hasValue(findUnusedValue(A));
            }
        );
        Prev +=> directlyBeforeOf(P);
        if (A=>hasValue()) P->hasValue.used = true;
        if (A=>hasEffects()) applyInterruptionMode(A->hasEffects, S);
        if (Tin=>hasEffects()) applyInterruptionMode(Tin->hasEffects, S)
    }) [
        skill = "correct_answer";
        RU.explanation = "Верно, следующим выполняется ${A}." ;
        EN.explanation = "Correct, the ${A} is executed next." ;
    ];
}

// Уточнение ошибок после предпрогонки: выполнение могло АВТОМАТИЧЕСКИ уйти
// вперёд от последнего шага студента (P0) — выйти из конструкции, содержащей A,
// либо войти в другую её ветвь. Тогда вместо общих ошибок порядка или
// отсутствия перехода возвращаем ошибку по первопричине. Вынужденные выходы
// при прерывании findCorrect добавляет БЕЗ перехода (нет hasTransition) — это
// отличает их от выходов по значению условия.
fragment autoPassedRefinement() {
    // после P0 конструкция с A была принудительно закрыта (акт END без перехода)
    ask (forAny TraceAct t {
        $t=>afterOf(P0) and inCurrentActivation($t, A->belongsTo) and
        $t->hasAction->derivedFrom.role == "END" and
        isAncestorOrSelf(A->belongsTo, $t->hasAction->belongsTo) and
        not $t=>hasTransition()
    }) out false else {
        // для объяснения: самая внешняя из принудительно закрытых конструкций с A
        // и действие, начавшее прерывание (его имя уже говорит, что это break/return).
        // Оба объекта гарантированы: ask выше проверил то же условие, а принудительный
        // выход бывает только после действия, начавшего прерывание
        var ForcedExit: ConcreteConstruct = findExtreme outer [isAncestorOrSelf($c, $outer)] among ConcreteConstruct c {
            isAncestorOrSelf(A->belongsTo, $c) and
            forAny TraceAct t {
                $t=>afterOf(P0) and inCurrentActivation($t, A->belongsTo) and
                $t->hasAction->derivedFrom.role == "END" and
                $t->hasAction->belongsTo == $c and
                not $t=>hasTransition()
            }
        } out true else {
            conclude: error [ exception = true; exceptionName = "NoForcedExitConstruct"; ];
        };
        var ForcedBy: ConcreteAction = lastInterrupterAction() out true else {
            conclude: error [ exception = true; exceptionName = "NoInterrupterAction"; ];
        };
        // эффект, которым ForcedBy начал прерывание (у правила действия или у самого
        // действия, как в startsInterruption): его вид называется в объяснении.
        // После предпрогонки S.interruption_mode уже сброшен концом конструкции,
        // поэтому вид берётся из эффекта, а не из S
        var ForcedKind: Effect = find Effect e {
            $e.interruption_start != InterruptionType:none and (
                (ForcedBy->derivedFrom=>hasEffects() and ForcedBy->derivedFrom->hasEffects == $e) or
                (ForcedBy=>hasEffects() and ForcedBy->hasEffects == $e)
            )
        } out true else {
            conclude: error [ exception = true; exceptionName = "NoInterruptionEffect"; ];
        };
        conclude: error [
            skill = "interruption_not_considered" ;
            RU.explanation = "Выполнение ${ForcedExit}[case='р'] прервано ${ForcedKind.interruption_start}[case='т'] из-за ${ForcedBy}[case='р'], поэтому ${A} сейчас не может быть выполнен." ;
            EN.explanation = "The execution of the ${ForcedExit} has been interrupted by a ${ForcedKind.interruption_start} because of the ${ForcedBy}, so the ${A} cannot be executed now." ;
        ];
    };
    // после P0 конструкция с A была закрыта по переходу либо выполнение вошло
    // в другую её ветвь — значение условия уже определило дальнейший путь
    ask (forAny TraceAct t {
        $t=>afterOf(P0) and inCurrentActivation($t, A->belongsTo) and (
            (
                $t->hasAction->derivedFrom.role == "END" and
                isAncestorOrSelf(A->belongsTo, $t->hasAction->belongsTo) and
                // выход именно по значению условия, а не естественное завершение тела
                $t=>hasTransition() and
                $t->hasTransition=>hasConstraints() and
                $t->hasTransition->hasConstraints.condition_value != OptionalBool:`null`
            ) or entersSiblingBranch($t, A)
        )
    }) out false else {
        // для объяснения: конструкция, из которой значение условия вывело выполнение,
        // либо ветвь, в которую оно уже вошло (последний такой вход). Одна из них
        // гарантирована ask выше
        var ValueExited: ConcreteConstruct = findExtreme outer [isAncestorOrSelf($c, $outer)] among ConcreteConstruct c {
            isAncestorOrSelf(A->belongsTo, $c) and
            forAny TraceAct t {
                $t=>afterOf(P0) and inCurrentActivation($t, A->belongsTo) and
                $t->hasAction->derivedFrom.role == "END" and
                $t->hasAction->belongsTo == $c and
                $t=>hasTransition() and
                $t->hasTransition=>hasConstraints() and
                $t->hasTransition->hasConstraints.condition_value != OptionalBool:`null`
            }
        } out false else {
            // для объяснения: условие, значение которого закрыло ValueExited, — последний
            // акт со значением внутри этой конструкции перед её END (в шаблон идёт
            // действие: у актов нет localizedName). Гарантировано: END по ограничению
            // condition_value бывает только сразу после вычисления условия конструкции
            var ExitAct: TraceAct = findExtreme latest [not $latest=>beforeOf($t)] among TraceAct t {
                $t=>afterOf(P0) and inCurrentActivation($t, A->belongsTo) and
                $t->hasAction->derivedFrom.role == "END" and
                $t->hasAction->belongsTo == ValueExited and
                $t=>hasTransition() and
                $t->hasTransition=>hasConstraints() and
                $t->hasTransition->hasConstraints.condition_value != OptionalBool:`null`
            } out true else {
                conclude: error [ exception = true; exceptionName = "NoValueExitAct"; ];
            };
            var ExitDeciderAct: TraceAct = findExtreme latest [not $latest=>beforeOf($d)] among TraceAct d {
                $d=>beforeOf(ExitAct) and
                $d->inFrame == ExitAct->inFrame and
                $d->hasAction->belongsTo == ValueExited and
                $d=>hasValue()
            } out true else {
                conclude: error [ exception = true; exceptionName = "NoValueExitDecider"; ];
            };
            var ExitDecider: ConcreteAction = ExitDeciderAct->hasAction;
            // правило — из ограничения перехода в END: конструкция заканчивается
            // именно при этом значении условия
            conclude: error [
                skill = "condition_value_not_considered" ;
                RU.explanation = "${ExitDecider} имеет значение ${ExitDeciderAct->hasValue.bool_value}, выполнение ${ValueExited}[case='р'] закончилось, поэтому ${A} сейчас не выполнится." ;
                EN.explanation = "The ${ExitDecider} has the value ${ExitDeciderAct->hasValue.bool_value}, the execution of the ${ValueExited} has ended, so the ${A} is not executed now." ;
            ];
        };
        var ValueEntered: ConcreteConstruct = find ConcreteConstruct c {
            forAny TraceAct t {
                $t=>afterOf(P0) and inCurrentActivation($t, A->belongsTo) and
                entersSiblingBranch($t, A) and
                $t->hasAction->belongsTo == $c and
                not forAny TraceAct u { $u=>afterOf($t) and $u->inFrame == $t->inFrame and entersSiblingBranch($u, A) }
            }
        } out false else {
            // для объяснения: условие, значение которого выбрало ValueEntered, — последний
            // акт со значением в конструкции A перед входом в эту ветвь
            var EnterAct: TraceAct = findExtreme latest [not $latest=>beforeOf($t)] among TraceAct t {
                $t=>afterOf(P0) and inCurrentActivation($t, A->belongsTo) and
                entersSiblingBranch($t, A) and
                $t->hasAction->belongsTo == ValueEntered
            } out true else {
                conclude: error [ exception = true; exceptionName = "NoValueEnterAct"; ];
            };
            var EnterDeciderAct: TraceAct = findExtreme latest [not $latest=>beforeOf($d)] among TraceAct d {
                $d=>beforeOf(EnterAct) and
                $d->inFrame == EnterAct->inFrame and
                $d->hasAction->belongsTo == A->belongsTo and
                $d=>hasValue()
            } out true else {
                conclude: error [ exception = true; exceptionName = "NoValueEnterDecider"; ];
            };
            var EnterDecider: ConcreteAction = EnterDeciderAct->hasAction;
            var EnterOwner: ConcreteConstruct = A->belongsTo;
            // A — само условие, которое только что выбрало ветвь (немедленный повтор):
            // причина не в другой ветви, а в том, что условие снова вычисляется не раньше
            // окончания выбранной им части
            ask (EnterDecider == A) out false else {
                conclude: error [
                    skill = "condition_value_not_considered" ;
                    RU.explanation = "${A} не может быть выполнен повторно, поскольку имеет значение ${EnterDeciderAct->hasValue.bool_value}, и в ${EnterOwner}[case='п'] выполняется ${ValueEntered}." ;
                    EN.explanation = "The ${A} cannot be executed again, because it has the value ${EnterDeciderAct->hasValue.bool_value}, and the ${ValueEntered} is executed in the ${EnterOwner}." ;
                ];
            };
            conclude: error [
                skill = "condition_value_not_considered" ;
                RU.explanation = "В ${EnterOwner}[case='п'] при значении ${EnterDeciderAct->hasValue.bool_value} в ${EnterDecider}[case='р'] выполняется ${ValueEntered}, а не ${A}." ;
                EN.explanation = "In the ${EnterOwner}, when the ${EnterDecider} has the value ${EnterDeciderAct->hasValue.bool_value}, the ${ValueEntered} is executed, not the ${A}." ;
            ];
        };
        conclude: error [ exception = true; exceptionName = "NoValueDecisionConstruct"; ];
    };
    conclude: null;
}

// Проверка одного уровня иерархии конструктов (переменная цикла — конструкт C).
// Шаги 5.1-5.3: резолвим роли D_p и D_a и классифицируем переход D_p -> D_a.
// Каждый непройденный критерий — отдельная локализованная ошибка;
// если все критерии пройдены — conclude: correct для этого уровня.
fragment checkLevel(C: ConcreteConstruct) {
    // 5.1.1: роль выбранного студентом действия A на уровне C
    var Da: ConcreteAction = currentRoleActionOf(A, C);
    // 5.1.2: роль предыдущего корректного действия P на уровне C (или BEGIN, если P вне C)
    var Dp: ConcreteAction = currentRoleActionOf(P->hasAction, C);

    // --- Вырожденный случай: роли совпали ---
    ask (Dp == Da) out false else {
        // Вход в сам конструкт C: A и есть его BEGIN, а P ещё вне C — корректный шаг уровня
        ask (A == Dp and A->derivedFrom.role == "BEGIN" and not hasContainingAction(P->hasAction, C)) out false else {
            conclude: correct;
        };
        // Отложенное действие preorder-конструкта: раскрытый из него конструкт уже
        // завершён (его END - последний акт трассы), значит сейчас это корректный шаг
        ask (A == Dp and isPendingUnfoldAction(A)) out false else {
            conclude: correct;
        };
        ask (A == Dp) out false else {
            // Студент повторно выбирает действие, на котором стоит трасса (или внутри
            // конструкта которого она находится). Авто-уход вперёд уже исключён
            // ранним вызовом autoPassedRefinement в теле дерева.
            var DccSame: ConcreteConstruct = find ConcreteConstruct cc {
                $cc != C and
                $cc.ast_id == Dp.ast_id
            } {
                false -> {
                    conclude: error [
                        skill = "actions_order_violated" ;
                        RU.explanation = "Действие ${A} не может повторяться, поскольку оно только что выполнилось." ;
                        EN.explanation = "The ${A} cannot be repeated, because it has just been executed." ;
                    ];
                }
                true -> {
                    conclude: error [
                        skill = "construct_not_closed" ;
                        RU.explanation = "Выполнение ${A}[case='р'] уже идёт и ещё не закончилось, поэтому заново ${A} сейчас не начнётся." ;
                        EN.explanation = "The execution of the ${A} is already in progress and has not finished yet, so the ${A} will not start again now." ;
                    ];
                }
            };
        };
        // Обе роли — одно действие, но A глубже (внутри раскрываемого конструкта):
        // этот уровень ограничений не накладывает, решают более глубокие уровни
        conclude: correct;
    };

    // Независимые необходимые условия уровня — агрегация AND, при нарушении
    // нескольких студент получает все объяснения:
    //   - вход в конструкт C (BEGIN C);
    //   - путь D_p -> D_a: пропуск шага D_a, затем цепочка уточняющих фильтров
    //     перехода (пропуск D_a и отсутствие перехода описывают один прыжок,
    //     поэтому внутри ветви они остаются последовательными);
    //   - завершённость конструкта, раскрытого из D_p.
    agg and {
        levelEntered -> {
            // --- Критерий: вход в конструкт C ещё не совершён ---
            // Если P вне C, вход достроится автоматически только при прозрачном BEGIN.
            ask (
                hasContainingAction(P->hasAction, C) or
                not beginActionOf(C)->derivedFrom.is_opaque
            ) out true else {
                conclude: error [
                    skill = "construct_not_entered" ;
                    RU.explanation = "${A} сейчас не выполнится, так как находится внутри ${C}[case='р'], а выполнение ${C}[case='р'] ещё не началось." ;
                    EN.explanation = "The ${A} is not executed now, because it is inside the ${C}, and the execution of the ${C} has not started yet." ;
                ];
            };
            conclude: correct;
        };
        transitionFromDp -> {
            // --- Критерий: пропуск непрозрачного промежуточного действия уровня C ---
            // Если D_a — не само A, оно достроится автоматически, если не является шагом студента
            // либо уже выполненным в текущем контексте (после последнего акта D_p).
            ask (
                Da == A or
                not Da->derivedFrom.is_opaque or
                // непрозрачное D_a, раскрывающее конструкт с прозрачным BEGIN, findCorrect
                // проходит сам (classifyAction/unfoldNewConstruct) — это не шаг студента
                autoPassedByUnfold(Da, C) or
                actAlreadyCurrent(Da, Dp) or
                // D_a позади D_p по цепочке — это не пропуск вперёд, а возврат назад:
                // его классифицирует критерий наличия перехода
                Da=>beforeOf(Dp) or
                // D_a раскрывает preorder-конструкт, внутри которого находится A:
                // само D_a выполняется ПОСЛЕ этого конструкта, пропуска нет
                isDeferredUnfoldAction(Da, A)
            ) out true else {
                conclude: error [
                    skill = "intermediate_action_skipped" ;
                    RU.explanation = "Вложенные действия выполняются только во время выполнения той части, в которую они входят. Так как это действие входит в ${Da}[case='в'], а выполнение ${Da}[case='р'] ещё не началось, ${A} сейчас не выполнится." ;
                    EN.explanation = "Nested actions are executed only while the part containing them runs. Since this action is part of the ${Da} and the ${Da} has not started yet, the ${A} is not executed now." ;
                ];
            };

            // --- Критерий 5.2/5.3.1: наличие перехода D_p -> D_a (без учёта ограничений) ---
            ask (forAny TransitionSpec t {
                transitionLeads($t, Dp, Da, C)
            }) out true else {
                // другая ветвь того же ветвления: её исключило значение условия, а не пропуск
                ask (branchAlternatives(Dp, Da, C)) out false else {
                    conclude: error [
                        skill = "condition_value_not_considered" ;
                        RU.explanation = "В ${C}[case='п'] выполняется только одно из действий: ${Dp}[case='р'] или ${A}[case='р']. Так как выполнение ${C}[case='р'] перешло в ${Dp}[case='д'], ${A} не выполнится." ;
                        EN.explanation = "In the ${C}, only one of the actions is executed: the ${Dp} or the ${A}. Since the execution of the ${C} has moved to the ${Dp}, the ${A} will not be executed." ;
                    ];
                };
                // классифицируем по порядку конкретных действий в цепочке (авто-уход
                // вперёд уже исключён ранним вызовом autoPassedRefinement).
                // Возврат назад, пока D_p ещё ждёт завершения раскрытого из него вызова,
                // — тоже «уже позади»: акта D_p в трассе ещё нет, и actAlreadyCurrent это не видит
                ask (Da=>beforeOf(Dp) and (not actAlreadyCurrent(Da, Dp) or awaitsUnfoldedConstruct(Dp, C))) out false else {
                    conclude: error [
                        skill = "action_already_passed" ;
                        RU.explanation = "Внутри ${C}[case='п'] не предусмотрено выполнение уже пройденных действий. Так как в ${C}[case='п'] это действие стоит раньше ${Dp}[case='р'], ${A} сейчас не сможет выполниться." ;
                        EN.explanation = "Inside the ${C}, actions that have already been passed are not executed again. Since this action comes before the ${Dp} in the ${C}, the ${A} cannot be executed now." ;
                    ];
                };
                ask (Da=>afterOf(Dp)) out false else {
                    // D_p — условие в конструкции, проверяющей условия по порядку до первого
                    // истинного (kind — только выбор правила, в тексте имя из localizedName)
                    ask (C->derivedFrom.kind == "compound.alternative" and Dp=>hasValue()) out false else {
                        conclude: error [
                            skill = "actions_skipped" ;
                            RU.explanation = "В ${C}[case='п'] условия проверяются по порядку до первого истинного. Так как между ${Dp}[case='т'] и этим действием есть ещё не проверенные условия, ${A} сейчас не выполнится." ;
                            EN.explanation = "In the ${C}, conditions are checked in order up to the first true one. Since there are unchecked conditions between the ${Dp} and this action, the ${A} is not executed now." ;
                        ];
                    };
                    // из D_p переходы ведут только в конец C: после D_p конструкция заканчивается
                    ask (forAny TransitionSpec tAny {
                        $tAny->belongsTo == C->derivedFrom and
                        $tAny->from_ == Dp->derivedFrom
                    } and not forAny TransitionSpec tEnd {
                        $tEnd->belongsTo == C->derivedFrom and
                        $tEnd->from_ == Dp->derivedFrom and
                        $tEnd->to_.role != "END"
                    }) out false else {
                        conclude: error [
                            skill = "actions_skipped" ;
                            RU.explanation = "После ${Dp}[case='р'] выполнение ${C}[case='р'] заканчивается, поэтому ${A} не выполнится." ;
                            EN.explanation = "After the ${Dp}, the execution of the ${C} ends, so the ${A} will not be executed." ;
                        ];
                    };
                    conclude: error [
                        skill = "actions_skipped" ;
                        RU.explanation = "Действия внутри ${C}[case='р'] выполняются по порядку. Так как между ${Dp}[case='т'] и этим ${A}[case='т'] есть ещё не выполненные действия, ${A} сейчас не выполнится." ;
                        EN.explanation = "Actions inside the ${C} are executed in order. Since there are actions between the ${Dp} and this ${A} that have not been executed yet, the ${A} is not executed now." ;
                    ];
                };
                conclude: error [
                    skill = "no_transition" ;
                    RU.explanation = "В ${C}[case='п'] после ${Dp}[case='р'] не следует ${A}, поэтому ${A} не может быть выполнен." ;
                    EN.explanation = "In the ${C}, the ${A} does not follow the ${Dp}, so the ${A} cannot be executed." ;
                ];
            };

            // --- Критерий 5.2: порядок конкретных действий (переходы «в себя» и цепочки) ---
            // Если целевая роль повторяется в цепочке однотипных действий, D_a должно быть
            // ближайшим подходящим после D_p (зеркало поиска N в findCorrect); назад — только
            // если впереди подходящих действий нет либо D_a уже пройдено в текущем контексте.
            ask (
                not Dp=>directlyBeforeOf() or
                actAlreadyCurrent(Da, Dp) or
                (
                    Da=>afterOf(Dp) and
                    not forAny ConcreteAction mid {
                        $mid != Da and
                        $mid->derivedFrom == Da->derivedFrom and
                        $mid->belongsTo == C and
                        $mid=>afterOf(Dp) and
                        Da=>afterOf($mid)
                    }
                ) or
                (
                    not forAny ConcreteAction fwd {
                        $fwd->derivedFrom == Da->derivedFrom and
                        $fwd->belongsTo == C and
                        $fwd=>afterOf(Dp)
                    }
                )
            ) out true else {
                // между D_p и D_a в цепочке C есть ещё не выполненные однотипные действия
                ask (C->derivedFrom.kind == "compound.alternative" and Dp=>hasValue()) out false else {
                    conclude: error [
                        skill = "actions_order_violated" ;
                        RU.explanation = "В ${C}[case='п'] условия проверяются по порядку до первого истинного. Так как между ${Dp}[case='т'] и этим действием есть ещё не проверенные условия, ${A} сейчас не выполнится." ;
                        EN.explanation = "In the ${C}, conditions are checked in order up to the first true one. Since there are unchecked conditions between the ${Dp} and this action, the ${A} is not executed now." ;
                    ];
                };
                conclude: error [
                    skill = "actions_order_violated" ;
                    RU.explanation = "Действия внутри ${C}[case='р'] выполняются по порядку. Так как между ${Dp}[case='т'] и этим ${A}[case='т'] есть ещё не выполненные действия, ${A} сейчас не выполнится." ;
                    EN.explanation = "Actions inside the ${C} are executed in order. Since there are actions between the ${Dp} and this ${A} that have not been executed yet, the ${A} is not executed now." ;
                ];
            };

            // --- Критерий 5.2: ограничение режима прерывания ---
            ask (forAny TransitionSpec t {
                transitionLeads($t, Dp, Da, C) and
                interruptionOk($t, S)
            }) out true else {
                // прерывания нет, а переход в D_a возможен только при нём (досрочный выход)
                ask (S.interruption_mode == InterruptionType:none) out false else {
                    conclude: error [
                        skill = "interruption_not_considered" ;
                        RU.explanation = "${A} следует за ${Dp}[case='т'] только при досрочном выходе из ${C}[case='р']. Так как досрочного выхода не было, ${A} сейчас не выполнится." ;
                        EN.explanation = "The ${A} follows the ${Dp} only on an early exit from the ${C}. Since there was no early exit, the ${A} is not executed now." ;
                    ];
                };
                // прерывание идёт (режим не none — значит, его начавшее действие есть в трассе)
                var LevelInterrupter: ConcreteAction = lastInterrupterAction() out true else {
                    conclude: error [ exception = true; exceptionName = "NoInterrupterAction"; ];
                };
                conclude: error [
                    skill = "interruption_not_considered" ;
                    RU.explanation = "Во время ${S.interruption_mode}[case='т'] выполняется выход из охватывающих ${LevelInterrupter}[case='в'] алгоритмических структур без выполнения действий, поэтому ${A} сейчас не выполнится." ;
                    EN.explanation = "During a ${S.interruption_mode}, execution leaves the constructs enclosing the ${LevelInterrupter} without executing actions, so the ${A} is not executed now." ;
                ];
            };

            // --- Критерий 5.2: ограничение значения условия ---
            // Значение D_p — то же, по которому conditionOk отверг переход в D_a;
            // правило — из ограничения этого перехода (требуется противоположное значение)
            ask (forAny TransitionSpec t {
                transitionLeads($t, Dp, Da, C) and
                interruptionOk($t, S) and
                conditionOk($t, Dp)
            }) out true else {
                // для объяснения: переход в D_a, отвергнутый только conditionOk (по режиму
                // прерывания подходящий переход гарантирован ask выше); в шаблон идёт
                // требуемое им значение условия, а не фактическое значение D_p
                var ValueTransition: TransitionSpec = find TransitionSpec t {
                    transitionLeads($t, Dp, Da, C) and
                    interruptionOk($t, S) and
                    $t=>hasConstraints() and
                    $t->hasConstraints.condition_value != OptionalBool:`null`
                } out true else {
                    conclude: error [ exception = true; exceptionName = "NoValueConstrainedTransition"; ];
                };
                conclude: error [
                    skill = "condition_value_not_considered" ;
                    RU.explanation = "В ${C}[case='п'] это действие следует за ${Dp}[case='т'], только когда оно имеет значение ${ValueTransition->hasConstraints.condition_value}, поэтому ${A} не выполнится." ;
                    EN.explanation = "In the ${C}, this action follows the ${Dp} only when it has the value ${ValueTransition->hasConstraints.condition_value}, so the ${A} will not be executed." ;
                ];
            };
            conclude: correct;
        };
        dpConstructFinished -> {
            // --- Критерий 5.3.2.1: конструкт, раскрытый из D_p, должен быть завершён ---
            var Dcc: ConcreteConstruct = find ConcreteConstruct cc {
                $cc != C and
                $cc.ast_id == Dp.ast_id
            } {
                false -> {
                    // D_p атомарно — все критерии уровня пройдены
                    conclude: correct;
                }
                true -> {
                    var DpAct: TraceAct = lastActOf(Dp) out true else {
                        // для preorder-конструкта акт D_p появляется только после его END,
                        // поэтому отсутствие акта означает "конструкт ещё выполняется"
                        ask (Dcc->derivedFrom.preorder) {
                            true -> {
                                conclude: error [
                                    skill = "construct_not_closed" ;
                                    RU.explanation = "Выполнение ${Dcc}[case='р'] ещё не закончилось, поэтому ${A} не может быть выполнен." ;
                                    EN.explanation = "The execution of the ${Dcc} has not finished yet, so the ${A} cannot be executed." ;
                                ];
                            }
                            false -> {
                                conclude: error [ exception = true; exceptionName = "NoActForRoleAction"; ];
                            }
                        };
                    };
                    ask (unfoldedConstructFinished(Dcc, DpAct)) {
                        true -> { conclude: correct; }
                        false -> {
                            conclude: error [
                                skill = "construct_not_closed" ;
                                RU.explanation = "Выполнение ${Dcc}[case='р'] ещё не закончилось, поэтому ${A} не может быть выполнен." ;
                                EN.explanation = "The execution of the ${Dcc} has not finished yet, so the ${A} cannot be executed." ;
                            ];
                        }
                    };
                }
            };
        };
    };
    conclude: correct;
}


// ---------------------------------------------------------------------------
//  Дерево проверок.
//    S — состояние трассировки, P — последний корректный акт частичной трассы,
//    A — выбранное студентом конкретное действие.
// ---------------------------------------------------------------------------
tpg CtrlFlow_check(S: TraceState, P: TraceAct, A: ConcreteAction) {
    // Последний акт ДО предпрогонки: всё, что появится в трассе после него,
    // добавлено автоматически (нужно фрагменту autoPassedRefinement).
    var P0: TraceAct = P;
    // Шаг 1 (предпрогонка): достроить прозрачные действия от P и обновить P/S.
    // subcall_mut персистит изменения трассы в общий домен; stop_on_opaque = false
    // останавливает подынтерпретатор ПЕРЕД первым непрозрачным действием.
    // Переменные не восстанавливаем (restoreVars = false): P ищем по последнему
    // акту трассы, а S — синглтон, меняются только его свойства.
    eval(obj:TraceConfig.stop_on_opaque = false);
    subcall_mut("findCorrect", false, S, P);
    eval(obj:TraceConfig.stop_on_opaque = true);
    eval(P = findExtreme lastAct [not $lastAct=>beforeOf($a)] among TraceAct a {true});
    // Кадр P закрыт (последний акт - END тела функции): выполнение вернулось в кадр
    // вызывающего, и точка отсчёта - акт func вызова (зеркало ветки END в findCorrect)
    eval(P = if (P->inFrame->inFrame != P->inFrame and frameClosed(P->inFrame)) P->inFrame else P);

    // Шаг 2а: программа уже полностью вычислена.
    ask (
        P->hasAction->belongsTo->derivedFrom.name == "global_statements_structure" and
        P->hasAction->derivedFrom.role == "END"
    ) out false else {
        var Program: ConcreteConstruct = P->hasAction->belongsTo;
        conclude: true [
            skill = "everything_evaluated" ;
            RU.explanation = "Выполнение ${Program}[case='р'] уже закончилось, поэтому ${A} больше не выполнится." ;
            EN.explanation = "The ${Program} has already finished, so the ${A} will not be executed anymore." ;
        ];
    };
    // Уточнение до проверки повторяемости: если выполнение после P0 уже
    // автоматически покинуло конструкцию с A (прерывание/значение условия),
    // причина ошибки — не исчерпание значений. Скоуп по P0 отличает этот
    // случай от честного исчерпания (конструкция закрыта до P0).
    `fragment`:autoPassedRefinement() out null;
    // Шаг 3.1: действие внутри функции, в которую не входили или из которой вышли.
    // Проверяется ДО шага 2б: у условий в завершённой функции значения тоже
    // израсходованы, но первопричина — выход из функции (при повторном вызове
    // значения сбросятся), а не исчерпание значений.
    // Конструкт тела функции открывается по эффекту call_stack = add_frame
    // (переход BEGIN -> func вызова, см. func_call_structure в constructs.yml),
    // поэтому корректный выбор внутри функции возможен только при открытом теле.
    ask (forAny ConcreteConstruct fd {
        $fd->derivedFrom.name == "func_def_structure" and
        isAncestorOrSelf(A->belongsTo, $fd) and
        not isConstructOpen($fd)
    }) out false else {
        ask (forAny ConcreteConstruct fd {
            $fd->derivedFrom.name == "func_def_structure" and
            isAncestorOrSelf(A->belongsTo, $fd) and
            not forAny TraceAct b {
                $b->hasAction->belongsTo == $fd and
                $b->hasAction->derivedFrom.role == "BEGIN"
            }
        }) {
            true -> {
                // для объяснения: самая внешняя из функций с A, в которые не входили
                // (гарантирована ask выше)
                var UncalledFunc: ConcreteConstruct = findExtreme outer [isAncestorOrSelf($c, $outer)] among ConcreteConstruct c {
                    $c->derivedFrom.name == "func_def_structure" and
                    isAncestorOrSelf(A->belongsTo, $c) and
                    not forAny TraceAct b {
                        $b->hasAction->belongsTo == $c and
                        $b->hasAction->derivedFrom.role == "BEGIN"
                    }
                } out true else {
                    conclude: error [ exception = true; exceptionName = "NoUncalledFunction"; ];
                };
                conclude: error [
                    skill = "function_not_entered" ;
                    RU.explanation = "Действия внутри ${UncalledFunc}[case='р'] выполняются только во время вызова. Так как это действие находится там, а вызова ещё не было, ${A} сейчас не выполнится." ;
                    EN.explanation = "Actions inside the ${UncalledFunc} are executed only during a call. Since this action is there and there has been no call yet, the ${A} is not executed now." ;
                ];
            }
            false -> {
                // для объяснения: самая внешняя из завершившихся функций с A
                // (гарантирована ask выше)
                var FinishedFunc: ConcreteConstruct = findExtreme outer [isAncestorOrSelf($c, $outer)] among ConcreteConstruct c {
                    $c->derivedFrom.name == "func_def_structure" and
                    isAncestorOrSelf(A->belongsTo, $c) and
                    not isConstructOpen($c)
                } out true else {
                    conclude: error [ exception = true; exceptionName = "NoFinishedFunction"; ];
                };
                conclude: error [
                    skill = "function_already_exited" ;
                    RU.explanation = "Действия внутри ${FinishedFunc}[case='р'] выполняются только во время вызова. Так как это действие находится там, а вызов уже закончился, ${A} не выполнится до следующего вызова ${FinishedFunc}[case='р']." ;
                    EN.explanation = "Actions inside the ${FinishedFunc} are executed only during a call. Since this action is there and the call has already finished, the ${A} will not be executed until the next call of the ${FinishedFunc}." ;
                ];
            }
        };
    };

    // Шаг 2б: действие уже выполнялось и не может повториться — в его цепочке
    // не осталось неиспользованных значений (пример: условие цикла while).
    ask (
        forAny TraceAct t {$t->hasAction == A} and
        A=>hasValue() and not forAny SemanticValue v {
            ($v == A->hasValue or $v=>afterOf(A->hasValue)) and not $v.used
        }
    ) out false else {
        conclude: error [
            skill = "action_cannot_repeat" ;
            RU.explanation = "${A} не может быть вычислено, поскольку выполнение больше не возвращается к этому действию." ;
            EN.explanation = "The ${A} cannot be evaluated, because execution does not return to this action anymore." ;
        ];
    };

    // Шаг 3.1а: A раскрывает preorder-конструкт (вложенный вызов), который ещё
    // выполняется. Само действие выполняется только ПОСЛЕ его завершения, а роль P
    // на уровнях вне тела вызванной функции по статической иерархии этого не видит,
    // поэтому проверяем явно.
    ask (forAny ConcreteConstruct cc {
        $cc != A->belongsTo and
        $cc.ast_id == A.ast_id and
        $cc->derivedFrom.preorder and
        isConstructOpen($cc)
    }) out false else {
        // для объяснения: самый внутренний открытый конструкт внутри раскрытого
        // из A preorder-конструкта — обычно выполняющийся сейчас вызов функции
        // (гарантирован: кандидатом всегда является сам раскрытый конструкт)
        var Blocking: ConcreteConstruct = findExtreme inner [isAncestorOrSelf($inner, $c)] among ConcreteConstruct c {
            isConstructOpen($c) and
            forAny ConcreteConstruct cc {
                $cc != A->belongsTo and
                $cc.ast_id == A.ast_id and
                $cc->derivedFrom.preorder and
                isConstructOpen($cc) and
                isAncestorOrSelf($c, $cc)
            }
        } out true else {
            conclude: error [ exception = true; exceptionName = "NoBlockingConstruct"; ];
        };
        conclude: error [
            skill = "construct_not_closed" ;
            RU.explanation = "Выполнение ${Blocking}[case='р'] ещё не закончилось, поэтому ${A} сейчас не выполнится." ;
            EN.explanation = "The execution of the ${Blocking} has not finished yet, so the ${A} is not executed now." ;
        ];
    };

    // Шаг 3.2: активное прерывание. Если режим прерывания не none, единственный
    // допустимый шаг — выход (END) из ещё не закрытого конструкта, содержащего P
    // (см. принудительный выход в findLastTracedAction из findCorrect).
    ask (
        S.interruption_mode != InterruptionType:none and
        not (
            A->derivedFrom.role == "END" and
            isConstructOpen(A->belongsTo) and
            isAncestorOrSelf(P->hasAction->belongsTo, A->belongsTo)
        )
    ) out false else {
        // для объяснения: действие, начавшее прерывание (режим не none — значит,
        // такое действие есть в трассе); вид прерывания — S.interruption_mode
        var Interrupter: ConcreteAction = lastInterrupterAction() out true else {
            conclude: error [ exception = true; exceptionName = "NoInterrupterAction"; ];
        };
        conclude: error [
            skill = "interruption_not_considered" ;
            RU.explanation = "Во время ${S.interruption_mode}[case='т'] выполняется выход из охватывающих ${Interrupter}[case='в'] алгоритмических структур без выполнения действий, поэтому ${A} сейчас не выполнится." ;
            EN.explanation = "During a ${S.interruption_mode}, execution leaves the constructs enclosing the ${Interrupter} without executing actions, so the ${A} is not executed now." ;
        ];
    };

    // Шаг 4: наиболее вложенный общий конструкт выбранного и предыдущего действий.
    var Common: ConcreteConstruct = commonConstruct(A, P->hasAction) out true else {
        conclude: error [ exception = true; exceptionName = "NoCommonConstruct"; ];
    };

    // Шаг 5: цикл агрегации по AND по конструктам от Common вниз до конструкта A.
    // Каждая итерация проверяет один уровень; ошибка любого уровня — ошибка ответа
    // (объяснение даёт conclude: error внутри checkLevel). Если все уровни пройдены,
    // шаг 6 фиксирует A в трассе и завершает граф успехом.
    cycle and (
        isAncestorOrSelf(A->belongsTo, $C) and
        isAncestorOrSelf($C, Common)
    ) with ConcreteConstruct C {
        body -> {
            `fragment`:checkLevel(C);
        };
        correct -> {
            `fragment`:commitCorrectAction();
        };
        error -> {
            conclude: error;
        };
    };
}
