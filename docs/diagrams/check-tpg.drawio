        <object label="Диагноз ошибки&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;идентификатор умения&lt;/font&gt;" tpgKind="LegendSample" id="lg_err">
