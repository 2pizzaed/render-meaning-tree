t;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(ConcreteAction)&lt;/font&gt; — это &lt;font color=&quot;#CC0066&quot;&gt;сущность AST&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#CC0066&quot;&gt;значение времени выполнения&lt;/font&gt; &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(SemanticValue)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt; &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(TraceAct)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#CC0066&quot;&gt;состояние трассировки&lt;/font&gt; &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(TraceState)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#CC0066&quot;&gt;конфигурация трассировки&lt;/font&gt; &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:16px&quot;&gt;(TraceConfigSpec)&lt;/font&gt;" tpgKind="Dictionary" tpgDict="Classes" tpgHint="ActionSpec/TransitionSpec/ConstructSpec : AbstractSpec; ConcreteConstruct/ConcreteAction : ASTEntity; видимые имена — терминология docs/domain.md, RU.localizedName модели: ConcreteConstruct='конструкция', ConcreteAction='действие', TraceAct='действие в трассе'" id="n_classes">
