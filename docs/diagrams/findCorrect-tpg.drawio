  <diagram id="flta" name="2. Нормализация точки отсчёта">
    <mxGraphModel dx="2804" dy="1662" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object label="&lt;b&gt;Фрагмент: нормализация точки отсчёта&lt;/b&gt;&amp;#160;&amp;#160;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;findLastTracedAction(last — последний акт трассы)&lt;/font&gt;" tpgKind="Fragment" tpgProcedure="fragment findLastTracedAction(last: TraceAct)" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" tpgNote="вызывается как `fragment`:findLastTracedAction(L) out true, null; исходы CORRECT и NULL возвращаются в основной граф, ERROR терминален" id="g_flta">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;collapsible=0;movable=1;resizable=1;fontSize=17;" vertex="1">
            <mxGeometry height="1107" width="2600" x="10" y="113" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Дано&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;last&lt;/font&gt; — последний &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt; &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;(при вызове = &lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;&lt;font color=&quot;#B38F00&quot;&gt;L&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;)&lt;/font&gt;" tpgKind="FragmentInputs" tpgVar="last: TraceAct" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_entry">
          <mxCell parent="g_flta" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#000000;size=0.06;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="400" x="410" y="52" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;while&lt;/b&gt;&lt;br&gt;активен &lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt;, и текущий &lt;font color=&quot;#CC0066&quot;&gt;конструкт&lt;/font&gt; — не корень программы" tpgKind="WhileCycleNode" tpgExpr="S.interruption_mode != InterruptionType:none&#xa;and last-&gt;hasAction-&gt;belongsTo-&gt;derivedFrom.name != &quot;global_statements_structure&quot;" tpgOutcomes="CORRECT, ERROR, NULL" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_while">
          <mxCell parent="g_flta" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="110" width="460" x="380" y="207" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; последнее &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; самого глубокого ещё &lt;b&gt;не закрытого&lt;/b&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;current&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="current: ConcreteAction" tpgExpr="(findExtreme act [$act == last or $act=&gt;isCloserToThan(last, $prev)] among TraceAct prev {&#xa;    forAny TraceAct c {&#xa;        $c-&gt;hasAction-&gt;belongsTo == $prev-&gt;hasAction-&gt;belongsTo&#xa;        and $c-&gt;hasAction-&gt;derivedFrom.role == &quot;BEGIN&quot;}&#xa;    and not forAny TraceAct c {&#xa;        $c-&gt;hasAction-&gt;belongsTo == $prev-&gt;hasAction-&gt;belongsTo&#xa;        and $c-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot;}&#xa;})-&gt;hasAction" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_find_current">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="120" width="420" x="400" y="397" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Не из чего выходить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;UnclosedInterruption&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgException="true" tpgExceptionName="UnclosedInterruption" tpgExpr="conclude: error [exception = true; exceptionName = &quot;UnclosedInterruption&quot;];" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_err_unclosed">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="280" x="50" y="407" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Снимают ли&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt; этого &lt;font color=&quot;#CC0066&quot;&gt;действия&lt;/font&gt; текущий &lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt;?" tpgKind="QuestionNode" tpgExpr="current-&gt;derivedFrom=&gt;hasEffects() and (&#xa;    current-&gt;derivedFrom-&gt;hasEffects.interruption_stop == S.interruption_mode or&#xa;    current-&gt;derivedFrom-&gt;hasEffects.interruption_stop == InterruptionType:any&#xa;)" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_q_stop">
          <mxCell parent="g_flta" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="140" width="440" x="390" y="577" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Прерывание снято&lt;/b&gt;&lt;br&gt;выходить из &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt; не нужно;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="NULL" tpgEffect="applyInterruptionMode(current-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (current=&gt;hasEffects()) applyInterruptionMode(current-&gt;hasEffects, S);" tpgExpr="conclude: null with ({ … });" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_res_stop">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6E6E6;strokeColor=#666666;fontSize=16;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="120" width="300" x="30" y="587" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;, которому &lt;font color=&quot;#0099A8&quot;&gt;принадлежит&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;current&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;exit&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="exit: ConcreteAction" tpgExpr="find ConcreteAction a { $a-&gt;derivedFrom.role == &quot;END&quot; and $a-&gt;belongsTo == current-&gt;belongsTo }" tpgNote="исход false в модели не объявлен: у узла есть только продолжение true" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_find_exit">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="420" x="400" y="777" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt;&lt;b&gt; конструкта добавлен в трассу&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;действия&lt;/font&gt; и &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;;&lt;br&gt;выход наружу продолжается на следующей итерации" tpgKind="BranchResultNode" tpgResult="NULL" tpgEffect="last = +obj : TraceAct ({&#xa;    hasAction(exit);&#xa;    (exit=&gt;hasValue()) ? hasValue(findUnusedValue(exit));&#xa;});&#xa;if (exit=&gt;hasValue()) last-&gt;hasValue.used = true;&#xa;if (exit-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(exit-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (current-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(current-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (exit=&gt;hasEffects()) applyInterruptionMode(exit-&gt;hasEffects, S);&#xa;if (current=&gt;hasEffects()) applyInterruptionMode(current-&gt;hasEffects, S);&#xa;exitPrev +=&gt; directlyBeforeOf(last);&#xa;// exitPrev: TraceAct = last  (служебная переменная связывания)" tpgExpr="conclude : null with ({ … });" tpgAdaptation="служебный узел var exitPrev: TraceAct = last не показан отдельно; его роль отражена в tpgEffect" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_res_exit">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6E6E6;strokeColor=#666666;fontSize=16;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="130" width="420" x="400" y="947" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Является ли&lt;/font&gt; текущая точка &lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt; своего &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;?" tpgKind="QuestionNode" tpgExpr="last-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot;" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_q_isend">
          <mxCell parent="g_flta" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="120" width="440" x="1130" y="182" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; ближайший &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt; ещё &lt;b&gt;не завершённого&lt;/b&gt; внешнего &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;possibleLast&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="possibleLast: TraceAct" tpgExpr="findExtreme lastAct [not $lastAct=&gt;beforeOf($c)] among TraceAct c {&#xa;    $c-&gt;hasAction-&gt;derivedFrom.role != &quot;END&quot; and&#xa;    not forAny TraceAct t2 {&#xa;        $t2-&gt;hasAction-&gt;belongsTo == $c-&gt;hasAction-&gt;belongsTo and&#xa;        $t2-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot; and&#xa;        $t2=&gt;afterOf($c)&#xa;    }&#xa;}" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_find_possible">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="420" x="1750" y="177" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Внутренняя ошибка&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;незавершённый конструкт не найден&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgException="true" tpgExpr="conclude : error [exception = true;];" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_err_int2">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="260" x="2290" y="187" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Продолжаем от внешнего конструкта&lt;/b&gt;&lt;br&gt;точка отсчёта = найденный &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgExpr="conclude: true with (last = possibleLast);" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_res_outer">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="120" width="420" x="1750" y="367" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Добавил ли&lt;/font&gt; последний &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;фрейм&lt;/font&gt; в &lt;b&gt;стек вызовов&lt;/b&gt;?" tpgKind="QuestionNode" tpgExpr="last=&gt;hasTransition() and last-&gt;hasTransition=&gt;hasEffects() and&#xa;last-&gt;hasTransition-&gt;hasEffects.call_stack != CallStackAction:none" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_q_callstack">
          <mxCell parent="g_flta" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="440" x="1130" y="532" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Выполняется ли&lt;/font&gt; эта функция прямо сейчас — её &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; уже в трассе и ещё не закрыт &lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt;?" tpgKind="QuestionNode" tpgExpr="forAny TraceAct act {&#xa;    $act-&gt;hasAction.ast_id == last-&gt;hasAction.ast_id and&#xa;    $act-&gt;hasAction-&gt;derivedFrom.role == &quot;BEGIN&quot; and&#xa;    not forAny TraceAct mid {&#xa;        $mid-&gt;hasAction.ast_id == last-&gt;hasAction.ast_id and&#xa;        $mid-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot; and&#xa;        $mid=&gt;isBetween($act, last)&#xa;    }&#xa;}" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_q_recursion">
          <mxCell parent="g_flta" style="ellipse;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="150" width="480" x="1720" y="522" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Рекурсия запрещена&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;RecursionDenied&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgException="true" tpgExceptionName="RecursionDenied" tpgExpr="conclude : error [exception = true; exceptionName = &quot;RecursionDenied&quot;;];" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_err_recursion">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1">
            <mxGeometry height="110" width="280" x="2290" y="547" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; тела вызываемой функции&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;callAction&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="callAction: ConcreteAction" tpgExpr="find ConcreteAction a { $a-&gt;derivedFrom.role == &quot;BEGIN&quot; and $a.ast_id == last-&gt;hasAction.ast_id }" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_find_call">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="120" width="420" x="1750" y="727" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Внутренняя ошибка&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;тело функции не найдено&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgException="true" tpgExpr="conclude : error [exception = true;];" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_err_int3">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="260" x="2290" y="742" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Вход в тело функции добавлен в трассу&lt;/b&gt;&lt;br&gt;точка отсчёта = &lt;font color=&quot;#009900&quot;&gt;BEGIN&lt;/font&gt; тела функции;&lt;br&gt;&lt;font color=&quot;#3333CC&quot;&gt;применены&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;эффекты&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgEffect="last = +obj : TraceAct ({&#xa;    hasAction(callAction);&#xa;    (callAction=&gt;hasValue()) ? hasValue(findUnusedValue(callAction));&#xa;});&#xa;if (callAction=&gt;hasValue()) last-&gt;hasValue.used = true;&#xa;if (callAction-&gt;derivedFrom=&gt;hasEffects()) applyInterruptionMode(callAction-&gt;derivedFrom-&gt;hasEffects, S);&#xa;if (callAction=&gt;hasEffects()) applyInterruptionMode(callAction-&gt;hasEffects, S);&#xa;callPrev +=&gt; directlyBeforeOf(last);" tpgExpr="conclude : true with ({ … });" tpgAdaptation="служебный узел var callPrev: TraceAct = last не показан отдельно" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_res_call">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="130" width="420" x="1750" y="907" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Точка отсчёта не изменилась&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;last&lt;/font&gt; и есть &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;, от которого ищется &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="NULL" tpgExpr="conclude : null;" tpgSource="domain/findCorrect.tpg :: fragment findLastTracedAction(last: TraceAct)" id="f_res_null">
          <mxCell parent="g_flta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6E6E6;strokeColor=#666666;fontSize=16;dashed=1;dashPattern=6 4;" vertex="1">
            <mxGeometry height="120" width="400" x="1150" y="897" as="geometry" />
          </mxCell>
        </object>
        <object label="От какого действия искать следующий переход?" id="f_t1">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontSize=27;fontStyle=1;" vertex="1">
            <mxGeometry height="34" width="1500" x="40" y="20" as="geometry" />
          </mxCell>
        </object>
        <object label="Фрагмент &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;findLastTracedAction&lt;/font&gt;, вызывается из основного графа (стр. 1). Словарь и легенда — на стр. 1." id="f_t2">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontSize=16;" vertex="1">
            <mxGeometry height="26" width="1800" x="40" y="58" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Выход из конструктов при прерывании&lt;/b&gt;&lt;br&gt;Пока активен &lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt; (&lt;font color=&quot;#009900&quot;&gt;прерывание цикла&lt;/font&gt;, &lt;font color=&quot;#009900&quot;&gt;прерывание итерации&lt;/font&gt;, &lt;font color=&quot;#009900&quot;&gt;возврат из функции&lt;/font&gt;, &lt;font color=&quot;#009900&quot;&gt;исключение&lt;/font&gt;), граф принудительно закрывает незавершённые &lt;font color=&quot;#CC0066&quot;&gt;конструкты&lt;/font&gt;, добавляя их &lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt; в трассу.&lt;br&gt;&lt;br&gt;Выход прекращается, когда встречается &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;, &lt;font color=&quot;#CC0066&quot;&gt;эффект&lt;/font&gt; которого снимает это прерывание, либо когда достигнут корень программы." tpgKind="Comment" id="f_note_loop">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;" vertex="1">
            <mxGeometry height="175" width="640" x="60" y="1290" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Три ситуации нормализации&lt;/b&gt;&lt;br&gt;1. Активно прерывание — выйти из вложенных &lt;font color=&quot;#CC0066&quot;&gt;конструктов&lt;/font&gt; (цикл слева).&lt;br&gt;2. Текущий &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt; уже &lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt; — подняться к ближайшему незавершённому внешнему &lt;font color=&quot;#CC0066&quot;&gt;конструкту&lt;/font&gt;.&lt;br&gt;3. Последний &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; менял стек вызовов — добавить вход в тело вызываемой функции.&lt;br&gt;&lt;br&gt;Если ничего из этого не требуется, точка отсчёта остаётся прежней." tpgKind="Comment" id="f_note_norm">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;" vertex="1">
            <mxGeometry height="175" width="640" x="740" y="1290" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Что возвращается в основной граф&lt;/b&gt;&lt;br&gt;&lt;b&gt;успех&lt;/b&gt; и &lt;b&gt;не определено&lt;/b&gt; — оба исхода продолжают основной граф: дальше ищется &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;ошибка&lt;/b&gt; прерывает рассуждение: все красные результаты здесь помечены метаданными &lt;i&gt;exception&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Пунктирная рамка результата означает, что он передаётся наружу — в объемлющий цикл или вызвавшей ветви." tpgKind="Comment" id="f_note_out">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;" vertex="1">
            <mxGeometry height="175" width="640" x="1420" y="1290" as="geometry" />
          </mxCell>
        </object>
