        </object>
        <object label="&lt;b&gt;Переход не найден или неоднозначен&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;AmbiguousOrMissingTransition&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgException="true" tpgExceptionName="AmbiguousOrMissingTransition" tpgExpr="conclude : error [exception = true; exceptionName = &quot;AmbiguousOrMissingTransition&quot;;];" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_err_amb">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1">
            <mxGeometry height="110" width="300" x="2370" y="2560" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; в том же &lt;font color=&quot;#CC0066&quot;&gt;конструкте&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;, в которое &lt;font color=&quot;#0099A8&quot;&gt;ведёт&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;для повторяющихся ролей — ближайшее подходящее после &lt;/font&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;&lt;font color=&quot;#B38F00&quot;&gt;L&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;N&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="N: ConcreteAction" tpgExpr="find ConcreteAction a {&#xa;    $a != L-&gt;hasAction and&#xa;    $a-&gt;derivedFrom == T-&gt;to_ and&#xa;    $a-&gt;belongsTo == L-&gt;hasAction-&gt;belongsTo and&#xa;    (&#xa;        not L-&gt;hasAction=&gt;directlyBeforeOf()&#xa;        or (&#xa;            $a=&gt;afterOf(L-&gt;hasAction) and&#xa;            not forAny ConcreteAction mid {&#xa;                $mid != $a and $mid-&gt;derivedFrom == T-&gt;to_ and&#xa;                $mid-&gt;belongsTo == $a-&gt;belongsTo and&#xa;                $mid=&gt;afterOf(L-&gt;hasAction) and $a=&gt;afterOf($mid)&#xa;            }&#xa;        )&#xa;        or (&#xa;            not T=&gt;to_when_absent() and&#xa;            not forAny ConcreteAction fwd {&#xa;                $fwd-&gt;derivedFrom == T-&gt;to_ and&#xa;                $fwd-&gt;belongsTo == L-&gt;hasAction-&gt;belongsTo and&#xa;                $fwd=&gt;afterOf(L-&gt;hasAction)&#xa;            }&#xa;        )&#xa;    )&#xa;}" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_find_N">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="460" x="1160" y="2810" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Найти&lt;/font&gt; запасное &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt;: первое реально присутствующее из &lt;font color=&quot;#CC0066&quot;&gt;цепочки&lt;/font&gt; «&lt;font color=&quot;#0099A8&quot;&gt;при отсутствии цели&lt;/font&gt;» &lt;font color=&quot;#CC0066&quot;&gt;перехода&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;N_absent&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="N_absent: ConcreteAction" tpgExpr="find ConcreteAction a {&#xa;    $a != L-&gt;hasAction and&#xa;    forAny ActionSpec absent {&#xa;        $absent == toWhenAbsent(T, L-&gt;hasAction-&gt;belongsTo) and&#xa;        $a-&gt;derivedFrom == $absent&#xa;    } and&#xa;    $a-&gt;belongsTo == L-&gt;hasAction-&gt;belongsTo and&#xa;    (&#xa;        not L-&gt;hasAction=&gt;directlyBeforeOf()&#xa;        or (&#xa;            $a=&gt;afterOf(L-&gt;hasAction) and&#xa;            not forAny ConcreteAction mid {&#xa;                $mid != $a and&#xa;                forAny ActionSpec absent {&#xa;                    $absent == toWhenAbsent(T, L-&gt;hasAction-&gt;belongsTo) and&#xa;                    $mid-&gt;derivedFrom == $absent&#xa;                } and&#xa;                $mid-&gt;belongsTo == $a-&gt;belongsTo and&#xa;                $mid=&gt;afterOf(L-&gt;hasAction) and $a=&gt;afterOf($mid)&#xa;            }&#xa;        )&#xa;    )&#xa;}&#xa;&#xa;// lambda toWhenAbsent(T, C) = if (T=&gt;to_when_absent()) (findExtreme present [&#xa;//     $present=&gt;isCloserToThan(T-&gt;to_when_absent, $ap) or $present == T-&gt;to_when_absent&#xa;// ] among ActionSpecChainPlaceholder ap {&#xa;//     ($ap=&gt;afterOf(T-&gt;to_when_absent) or $ap == T-&gt;to_when_absent) and&#xa;//     forAny ConcreteAction aa {C=&gt;hasActions($aa) and $aa=&gt;derivedFrom($ap-&gt;contains)}&#xa;// })-&gt;contains else T-&gt;to_;" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_find_Nabs">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="130" width="460" x="1790" y="2810" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Следующего действия нет&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;NoNextAction&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgException="true" tpgExceptionName="NoNextAction" tpgExpr="conclude : error [exception = true; exceptionName = &quot;NoNextAction&quot;;];" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_err_nonext">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="280" x="2375" y="2825" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Обработать&lt;/font&gt; найденное &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;N&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;фрагмент «Учёт повторяющихся действий» — стр. 3&lt;/font&gt;" tpgKind="ProcedureCallNode" tpgProcedure="fragment checkRepeatedAction(N: ConcreteAction)" tpgExpr="`fragment`:checkRepeatedAction(N);" tpgOutcomes="результаты фрагмента становятся результатом итерации цикла" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_call_chk1">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1">
            <mxGeometry height="110" width="420" x="1180" y="3010" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Обработать&lt;/font&gt; найденное &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;N_absent&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;фрагмент «Учёт повторяющихся действий» — стр. 3&lt;/font&gt;" tpgKind="ProcedureCallNode" tpgProcedure="fragment checkRepeatedAction(N: ConcreteAction)" tpgExpr="`fragment`:checkRepeatedAction(N_absent);" tpgOutcomes="результаты фрагмента становятся результатом итерации цикла" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_call_chk2">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1">
            <mxGeometry height="110" width="420" x="1810" y="3010" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Главная идея&lt;/b&gt;&lt;br&gt;Цикл продолжается, пока точка отсчёта &lt;font color=&quot;#B38F00&quot;&gt;L&lt;/font&gt; остаётся &lt;font color=&quot;#009900&quot;&gt;прозрачным&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;действием&lt;/font&gt; или всё ещё совпадает с исходным &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt;.&lt;br&gt;&lt;br&gt;Результат &lt;b&gt;null&lt;/b&gt; внутри тела означает: ответ ещё не найден — в трассу добавлен служебный шаг, и цикл повторяется.&lt;br&gt;&lt;br&gt;Итог цикла: &lt;b&gt;успех&lt;/b&gt; или &lt;b&gt;ошибка&lt;/b&gt; → граф отвечает &lt;i&gt;true&lt;/i&gt;; &lt;b&gt;не определено&lt;/b&gt; → &lt;i&gt;false&lt;/i&gt; с пометкой &lt;i&gt;exception&lt;/i&gt;." tpgKind="Comment" id="note_while">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;" vertex="1">
            <mxGeometry height="200" width="400" x="-164" y="1886" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Выбор перехода&lt;/b&gt;&lt;br&gt;Фазы проверяются по убыванию специфичности: сначала полное совпадение &lt;font color=&quot;#009900&quot;&gt;режима прерывания&lt;/font&gt; и &lt;font color=&quot;#009900&quot;&gt;значения условия&lt;/font&gt;, затем частичное, затем только &lt;font color=&quot;#009900&quot;&gt;значение условия&lt;/font&gt;, в конце — &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; без &lt;font color=&quot;#CC0066&quot;&gt;ограничений&lt;/font&gt;.&lt;br&gt;&lt;br&gt;Первая успешная фаза определяет &lt;font color=&quot;#CC0066&quot;&gt;переход&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;T&lt;/font&gt;; все четыре ветви «найден» ведут в одно продолжение." tpgKind="Comment" id="note_casc">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;" vertex="1">
            <mxGeometry height="190" width="400" x="60" y="2540" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Чем заканчивается итерация&lt;/b&gt;&lt;br&gt;Вызов фрагмента здесь завершает ветвь: его результат и есть результат итерации цикла.&lt;br&gt;&lt;b&gt;correct&lt;/b&gt; — найдено непрозрачное действие, поиск окончен;&lt;br&gt;&lt;b&gt;null&lt;/b&gt; — добавлен служебный шаг, цикл повторяется." tpgKind="Comment" id="note_calls">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;" vertex="1">
