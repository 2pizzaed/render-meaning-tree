          </mxCell>
        </object>
        <object label="&lt;b&gt;Задача графа&lt;/b&gt;&lt;br&gt;По уже построенной части трассы найти &lt;b&gt;следующее корректное действие&lt;/b&gt; трассировки программы.&lt;br&gt;&lt;br&gt;&lt;b&gt;Дано:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;S&lt;/font&gt; — &lt;font color=&quot;#CC0066&quot;&gt;состояние трассировки&lt;/font&gt; (текущий &lt;font color=&quot;#009900&quot;&gt;режим прерывания&lt;/font&gt;);&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt; — последний корректный &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt;&lt;br&gt;• обновлённый &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt; и достроенная трасса: в неё добавляются прозрачные действия, BEGIN/END раскрываемых конструктов, вход в тело функции и выходы из конструктов при прерывании;&lt;br&gt;• обновлённое &lt;font color=&quot;#CC0066&quot;&gt;состояние трассировки&lt;/font&gt; &lt;font color=&quot;#B38F00&quot;&gt;S&lt;/font&gt;;&lt;br&gt;• &lt;b&gt;correct&lt;/b&gt; — следующее непрозрачное действие найдено или программа полностью протрассирована;&lt;br&gt;• &lt;b&gt;error&lt;/b&gt; — продолжить рассуждение не удалось либо обнаружена внутренняя невозможная ситуация.&lt;br&gt;&lt;br&gt;Граф не сравнивает ответ студента с эталоном: трасса достраивается вперёд от &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt; до ближайшего &lt;font color=&quot;#009900&quot;&gt;непрозрачного&lt;/font&gt; действия." tpgKind="Documentation" id="n_task">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;" vertex="1">
            <mxGeometry height="380" width="620" x="1171" y="453" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Страницы файла&lt;/b&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Словарь и основной граф &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;CtrlFlow_findCorrect&lt;/font&gt; (эта страница)&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Фрагмент «Нормализация точки отсчёта» &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;findLastTracedAction&lt;/font&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Фрагменты «Обработка найденного действия» &lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;checkRepeatedAction → classifyAction → unwindNewConstruct&lt;/font&gt;&lt;br&gt;&lt;br&gt;Фрагменты вынесены на отдельные страницы: в модели они переиспользуются из нескольких мест графа. Словарь и легенда действуют для всех страниц." tpgKind="Documentation" id="n_pages">
          <mxCell parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;" vertex="1">
            <mxGeometry height="180" width="670" x="2500" y="950" as="geometry" />
          </mxCell>
        </object>
        <object label="Граф: какое действие трассировки должно быть выполнено следующим?" id="m_t1">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontSize=27;fontStyle=1;" vertex="1">
            <mxGeometry height="34" width="1500" x="40" y="1270" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;CtrlFlow_findCorrect&lt;/font&gt; — трасса достраивается вперёд от последнего корректного действия до ближайшего непрозрачного. Словарь и легенда — выше." id="m_t2">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontSize=16;" vertex="1">
            <mxGeometry height="26" width="1700" x="40" y="1308" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Дано&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;S&lt;/font&gt; — &lt;font color=&quot;#CC0066&quot;&gt;состояние трассировки&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt; — последний корректный &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;" tpgKind="DecisionTreeInputs" tpgVar="S: TraceState, P: TraceAct" tpgExpr="tpg CtrlFlow_findCorrect(S: TraceState, P: TraceAct)" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_entry">
          <mxCell parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#000000;size=0.06;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="340" x="530" y="1360" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Взять&lt;/font&gt; точку отсчёта рассуждения — последний корректный &lt;font color=&quot;#CC0066&quot;&gt;акт трассы&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;L&lt;/font&gt;" tpgKind="FindActionNode" tpgVar="L: TraceAct" tpgExpr="P" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" tpgNote="L — текущая точка рассуждения, P — последнее корректное действие" id="n_L">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="80" width="320" x="540" y="1510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;while&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;L&lt;/font&gt; — &lt;font color=&quot;#009900&quot;&gt;прозрачное&lt;/font&gt; &lt;font color=&quot;#CC0066&quot;&gt;действие&lt;/font&gt; или &lt;font color=&quot;#B38F00&quot;&gt;L&lt;/font&gt; всё ещё = &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt;" tpgKind="WhileCycleNode" tpgExpr="not L-&gt;hasAction-&gt;derivedFrom.is_opaque or L == P" tpgOutcomes="CORRECT, ERROR, NULL" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_while">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=16;" vertex="1">
            <mxGeometry height="100" width="360" x="520" y="1650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Следующее корректное действие найдено&lt;/b&gt;&lt;br&gt;ответ — &lt;font color=&quot;#B38F00&quot;&gt;P&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="CORRECT" tpgExpr="conclude : true;" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect :: while → true, false" id="n_ok">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;" vertex="1">
            <mxGeometry height="90" width="340" x="100" y="1620" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Продолжить рассуждение не удалось&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot; style=&quot;font-size:13px&quot;&gt;цикл завершился без определённого ответа&lt;/font&gt;" tpgKind="BranchResultNode" tpgResult="ERROR" tpgException="true" tpgExpr="conclude : false [exception=true;];" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect :: while → null" id="n_fail">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1">
            <mxGeometry height="90" width="340" x="100" y="1750" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;font color=&quot;#3333CC&quot;&gt;Достигнут ли&lt;/font&gt; &lt;font color=&quot;#009900&quot;&gt;END&lt;/font&gt; корневого &lt;font color=&quot;#CC0066&quot;&gt;конструкта&lt;/font&gt; программы?" tpgKind="QuestionNode" tpgExpr="L-&gt;hasAction-&gt;belongsTo-&gt;derivedFrom.name == &quot;global_statements_structure&quot; and L-&gt;hasAction-&gt;derivedFrom.role == &quot;END&quot;" tpgSource="domain/findCorrect.tpg :: tpg CtrlFlow_findCorrect" id="n_q_end">
